Subject: [PATCH 04/27] byteplan: metal fuse qwen4exp hc_post gate chain
 SCALE->SIGMOID->SCALE->DSV4_HC_POST (port of vulkan #29520)

---
 ggml/src/ggml-metal/ggml-metal-fusion.cpp |  38 +++++++
 ggml/src/ggml-metal/ggml-metal-fusion.h   |   1 +
 ggml/src/ggml-metal/ggml-metal-impl.h     |   3 +
 ggml/src/ggml-metal/ggml-metal-ops.cpp    | 119 +++++++++++++---------
 ggml/src/ggml-metal/kernels/misc.metal    |   6 ++
 5 files changed, 120 insertions(+), 47 deletions(-)

diff --git a/ggml/src/ggml-metal/ggml-metal-fusion.cpp b/ggml/src/ggml-metal/ggml-metal-fusion.cpp
index cd51a38..8ebcd0d 100644
--- a/ggml/src/ggml-metal/ggml-metal-fusion.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-fusion.cpp
@@ -227,6 +227,41 @@ static bool ggml_metal_fusion_check_add_chain(
 // mirrors ggml_metal_op_can_fuse_gdn_cache (PR #25788). the gdn output has other consumers (the
 // attn scores view), so unlike the other patterns this is not an elision chain: the structural
 // checks live entirely in this callback (unsafe = true).
+// byteplan: qwen4exp hc_combine builds post = 2*sigmoid(inject/hc) only for DSV4_HC_POST (port of Vulkan #29520);
+// the hc_post kernel applies it while loading post, the three elementwise kernels go away
+static bool ggml_metal_fusion_check_hc_post_gate(
+        const ggml_metal_fusion       * fusion,
+        const ggml_tensor * const     * nodes,
+        const ggml_cgraph             * gf,
+        const int                     * node_idxs,
+              int                       idx,
+              ggml_metal_fusion_mode    mode) {
+    GGML_UNUSED(mode);
+
+    const ggml_tensor * scale_in  = nodes[0];
+    const ggml_tensor * sigmoid   = nodes[1];
+    const ggml_tensor * scale_out = nodes[2];
+    const ggml_tensor * hc_post   = nodes[3];
+
+    if (ggml_get_unary_op(sigmoid) != GGML_UNARY_OP_SIGMOID ||
+        sigmoid->src[0] != scale_in || scale_out->src[0] != sigmoid || hc_post->src[2] != scale_out) {
+        return false;
+    }
+
+    // the kernel folds scale -> sigmoid -> scale; a bias on either scale is not handled
+    if (ggml_get_op_params_f32(scale_in, 1) != 0.0f || ggml_get_op_params_f32(scale_out, 1) != 0.0f) {
+        return false;
+    }
+
+    if (scale_in->src[0]->type != GGML_TYPE_F32 || scale_out->type != GGML_TYPE_F32 ||
+        !ggml_are_same_shape(scale_in->src[0], scale_out)) {
+        return false;
+    }
+
+    const int outputs[1] = { node_idxs[idx + 3] };
+    return ggml_can_fuse_subgraph_ext(gf, node_idxs + idx, (int) fusion->ops.size(), fusion->ops.data(), outputs, 1);
+}
+
 static bool ggml_metal_fusion_check_gdn_cache(
         const ggml_metal_fusion       * fusion,
         const ggml_tensor * const     * nodes,
@@ -769,6 +804,8 @@ static const std::vector<ggml_op> ops_moe_reduce_10 = {
 
 static const std::vector<ggml_op> ops_mul_mat_add = { GGML_OP_MUL_MAT, GGML_OP_ADD };
 
+static const std::vector<ggml_op> ops_hc_post_gate = { GGML_OP_SCALE, GGML_OP_UNARY, GGML_OP_SCALE, GGML_OP_DSV4_HC_POST };
+
 static const std::vector<ggml_metal_fusion> ggml_metal_fusions = {
     { GGML_METAL_FUSION_NORM_MUL,       ops_norm_mul,               {},     false, ggml_metal_fusion_check_norm },
     { GGML_METAL_FUSION_NORM_MUL_ADD,   ops_norm_mul_add,           {},     false, ggml_metal_fusion_check_norm },
@@ -798,6 +835,7 @@ static const std::vector<ggml_metal_fusion> ggml_metal_fusions = {
     { GGML_METAL_FUSION_MOE_REDUCE,     ops_moe_reduce_9,           {},     true,  ggml_metal_fusion_check_moe_reduce },
     { GGML_METAL_FUSION_MOE_REDUCE,     ops_moe_reduce_10,          {},     true,  ggml_metal_fusion_check_moe_reduce },
     { GGML_METAL_FUSION_SSM_CONV_SILU,  ops_ssm_conv_silu,          {},     false, ggml_metal_fusion_check_ssm_conv_silu },
+    { GGML_METAL_FUSION_HC_POST_GATE,   ops_hc_post_gate,           {},     true,  ggml_metal_fusion_check_hc_post_gate },
     { GGML_METAL_FUSION_MUL_MAT_ADD,    ops_mul_mat_add,            {},     false, ggml_metal_fusion_check_mul_mat_add },
 };
 
