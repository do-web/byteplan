 int ggml_metal_op_unary(ggml_metal_op_t ctx, int idx) {
     ggml_tensor * op = ctx->node(idx);
 
+    if (op->op == GGML_OP_SCALE && ctx->use_fusion()) {
+        int n = 1;
+        const ggml_metal_fusion * fusion = ctx->can_fuse(idx, GGML_METAL_FUSION_FULL, &n);
+        if (fusion && ggml_metal_fusion_get_id(fusion) == GGML_METAL_FUSION_HC_POST_GATE) {
+            ggml_metal_op_dsv4_hc_post(ctx, ctx->node(idx + n - 1), op);
+            ctx->count_fusions(fusion);
+            return n;
+        }
+    }
+
     ggml_metal_library_t lib = ctx->lib;
     ggml_metal_encoder_t enc = ctx->enc;
 
@@ -1432,9 +1444,69 @@ int ggml_metal_op_lightning_indexer(ggml_metal_op_t ctx, int idx) {
     return 1;
 }
 
+// gate_in: first SCALE of a fused hc_post gate chain (GGML_METAL_FUSION_HC_POST_GATE), else nullptr
+static void ggml_metal_op_dsv4_hc_post(ggml_metal_op_t ctx, const ggml_tensor * op, const ggml_tensor * gate_in) {
+    ggml_metal_encoder_t enc = ctx->enc;
+    ggml_metal_encoder_set_pipeline(enc, ggml_metal_library_get_pipeline_dsv4_hc(ctx->lib, op));
+
+    const ggml_tensor * x        = op->src[0];
+    const ggml_tensor * residual = op->src[1];
+    // fused gate: post is scale(sigmoid(scale(p_src))), the kernel applies it to p_src
+    const ggml_tensor * post     = gate_in ? gate_in->src[0] : op->src[2];
+    const ggml_tensor * comb     = op->src[3];
+
+    GGML_ASSERT(x->type        == GGML_TYPE_F32);
+    GGML_ASSERT(residual->type == GGML_TYPE_F32);
+    GGML_ASSERT(post->type     == GGML_TYPE_F32);
+    GGML_ASSERT(op->type       == GGML_TYPE_F32);
+    GGML_ASSERT(residual->ne[1] == 4);
+
+    ggml_metal_kargs_dsv4_hc_post args = {
+        /*.n_embd   =*/ (int32_t) x->ne[0],
+        /*.n_tokens =*/ (int32_t) x->ne[1],
+        /*.nb_x0    =*/ x->nb[0],
+        /*.nb_x1    =*/ x->nb[1],
+        /*.nb_r0    =*/ residual->nb[0],
+        /*.nb_r1    =*/ residual->nb[1],
+        /*.nb_r2    =*/ residual->nb[2],
+        /*.nb_p0    =*/ post->nb[0],
+        /*.nb_p1    =*/ post->nb[1],
+        /*.nb_c0    =*/ comb ? comb->nb[0] : 0,
+        /*.nb_c1    =*/ comb ? comb->nb[1] : 0,
+        /*.nb_c2    =*/ comb ? comb->nb[2] : 0,
+        /*.nb_d0    =*/ op->nb[0],
+        /*.nb_d1    =*/ op->nb[1],
+        /*.nb_d2    =*/ op->nb[2],
+        /*.gate           =*/ gate_in ? 1 : 0,
+        /*.gate_scale_in  =*/ gate_in ? ggml_get_op_params_f32(gate_in, 0) : 1.0f,
+        /*.gate_scale_out =*/ gate_in ? ggml_get_op_params_f32(op->src[2], 0) : 1.0f,
+    };
+
+    ggml_metal_encoder_set_bytes (enc, &args, sizeof(args), 0);
+    ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(x),        1);
+    ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(residual), 2);
+    ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(post),     3);
+    if (comb) {
+        ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(comb), 4);
+        ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(op),   5);
+    } else {
+        ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(op),   4);
+    }
+
+    const int n_tiles = (args.n_embd + 31)/32;
+    const int nsg = std::min(4, n_tiles);
+    ggml_metal_encoder_dispatch_threadgroups(
+            enc, (n_tiles + nsg - 1)/nsg, args.n_tokens, 1, 32, nsg, 1);
+}
