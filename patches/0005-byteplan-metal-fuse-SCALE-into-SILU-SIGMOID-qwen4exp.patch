diff --git a/ggml/src/ggml-metal/ggml-metal-fusion.cpp b/ggml/src/ggml-metal/ggml-metal-fusion.cpp
index 8ebcd0d..c0dbb1e 100644
--- a/ggml/src/ggml-metal/ggml-metal-fusion.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-fusion.cpp
@@ -227,6 +227,33 @@ static bool ggml_metal_fusion_check_add_chain(
 // mirrors ggml_metal_op_can_fuse_gdn_cache (PR #25788). the gdn output has other consumers (the
 // attn scores view), so unlike the other patterns this is not an elision chain: the structural
 // checks live entirely in this callback (unsafe = true).
+// byteplan: SCALE feeding SILU/SIGMOID (qwen4exp hc mix: silu(down/hc)); the unary kernel reads the scale's source
+static bool ggml_metal_fusion_check_scale_unary(
+        const ggml_metal_fusion       * fusion,
+        const ggml_tensor * const     * nodes,
+        const ggml_cgraph             * gf,
+        const int                     * node_idxs,
+              int                       idx,
+              ggml_metal_fusion_mode    mode) {
+    GGML_UNUSED(fusion);
+    GGML_UNUSED(gf);
+    GGML_UNUSED(node_idxs);
+    GGML_UNUSED(idx);
+    GGML_UNUSED(mode);
+
+    const ggml_tensor * scale = nodes[0];
+    const ggml_tensor * un    = nodes[1];
+
+    const ggml_unary_op uop = ggml_get_unary_op(un);
+    if (uop != GGML_UNARY_OP_SILU && uop != GGML_UNARY_OP_SIGMOID) {
+        return false;
+    }
+
+    // the scale's source replaces the scale output 1:1, so it must have the same layout
+    return un->src[0] == scale && scale->src[0]->type == GGML_TYPE_F32 && scale->type == GGML_TYPE_F32 &&
+           un->type == GGML_TYPE_F32 && ggml_is_contiguous(scale->src[0]) && ggml_is_contiguous(scale);
+}
+
 // byteplan: qwen4exp hc_combine builds post = 2*sigmoid(inject/hc) only for DSV4_HC_POST (port of Vulkan #29520);
 // the hc_post kernel applies it while loading post, the three elementwise kernels go away
 static bool ggml_metal_fusion_check_hc_post_gate(
@@ -804,6 +831,8 @@ static const std::vector<ggml_op> ops_moe_reduce_10 = {
 
 static const std::vector<ggml_op> ops_mul_mat_add = { GGML_OP_MUL_MAT, GGML_OP_ADD };
 
+static const std::vector<ggml_op> ops_scale_unary = { GGML_OP_SCALE, GGML_OP_UNARY };
+
 static const std::vector<ggml_op> ops_hc_post_gate = { GGML_OP_SCALE, GGML_OP_UNARY, GGML_OP_SCALE, GGML_OP_DSV4_HC_POST };
 
 static const std::vector<ggml_metal_fusion> ggml_metal_fusions = {
@@ -836,6 +865,7 @@ static const std::vector<ggml_metal_fusion> ggml_metal_fusions = {
     { GGML_METAL_FUSION_MOE_REDUCE,     ops_moe_reduce_10,          {},     true,  ggml_metal_fusion_check_moe_reduce },
     { GGML_METAL_FUSION_SSM_CONV_SILU,  ops_ssm_conv_silu,          {},     false, ggml_metal_fusion_check_ssm_conv_silu },
     { GGML_METAL_FUSION_HC_POST_GATE,   ops_hc_post_gate,           {},     true,  ggml_metal_fusion_check_hc_post_gate },
+    { GGML_METAL_FUSION_SCALE_UNARY,    ops_scale_unary,            {},     false, ggml_metal_fusion_check_scale_unary },
     { GGML_METAL_FUSION_MUL_MAT_ADD,    ops_mul_mat_add,            {},     false, ggml_metal_fusion_check_mul_mat_add },
 };
 
