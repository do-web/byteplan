diff --git a/tools/server/server-http.cpp b/tools/server/server-http.cpp
index 33cbb15..e9648cb 100644
--- a/tools/server/server-http.cpp
+++ b/tools/server/server-http.cpp
@@ -312,16 +312,37 @@ bool server_http_context::init_listener(const common_params & params) {
             // no endpoints are allowed to be accessed when the server is not ready
             // this is to prevent any data races or inconsistent states
             res.status = 503;
-            res.set_content(
-                safe_json_to_str(json {
-                    {"error", {
-                        {"message", "Loading model"},
-                        {"type", "unavailable_error"},
-                        {"code", 503}
-                    }}
-                }),
-                "application/json; charset=utf-8"
-            );
+            json err = {
+                {"message", "Loading model"},
+                {"type", "unavailable_error"},
+                {"code", 503}
+            };
+            {
+                // byteplan: progress for the UI; overall weights the stages by their typical share of the load time
+                std::lock_guard<std::mutex> lock(load_mu);
+                if (!load_stage.empty()) {
+                    const auto weight = [](const std::string & s) {
+                        return s == "text_model" ? 0.55 : s == "experts" ? 0.30 : s == "spec_model" ? 0.10 : 0.05;
+                    };
+                    double total = 0.0, before = 0.0;
+                    bool   seen  = false;
+                    for (const auto & s : load_stages) {
+                        total += weight(s);
+                        seen = seen || s == load_stage;
+                        if (!seen) {
+                            before += weight(s);
+                        }
+                    }
+                    const double overall = total > 0.0 ? (before + weight(load_stage) * load_value) / total : 0.0;
+                    err["progress"] = {
+                        {"stage",   load_stage},
+                        {"stages",  load_stages},
+                        {"value",   load_value},
+                        {"overall", std::min(1.0, overall)},
+                    };
+                }
+            }
+            res.set_content(safe_json_to_str(json {{"error", err}}), "application/json; charset=utf-8");
             return false;
         }
         return true;
