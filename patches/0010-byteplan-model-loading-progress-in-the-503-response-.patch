@@ -10,7 +10,25 @@ import { ServerRole } from '$lib/enums';
 import { PropsService } from '$lib/services/props.service';
 import { ApiError } from '$lib/utils';
 
-const LOADING_RETRY_INTERVAL_MS = 1000;
+const LOADING_RETRY_INTERVAL_MS = 500;
+
+/** Model loading progress sent by the server with its 503 "Loading model" response. */
+export interface ServerLoadProgress {
+	stage: string;
+	stages: string[];
+	/** 0..1 of the current stage */
+	value: number;
+	/** 0..1 of the whole load, stages weighted by their typical duration */
+	overall: number;
+}
+
+function loadProgressOf(error: unknown): ServerLoadProgress | null {
+	if (!(error instanceof ApiError)) return null;
+
+	const progress = (error.data as { error?: { progress?: ServerLoadProgress } } | undefined)?.error?.progress;
+
+	return typeof progress?.overall === 'number' ? progress : null;
+}
 
