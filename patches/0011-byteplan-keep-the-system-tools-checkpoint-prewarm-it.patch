diff --git a/tools/ui/src/lib/services/prewarm.service.ts b/tools/ui/src/lib/services/prewarm.service.ts
new file mode 100644
index 0000000..be073e6
--- /dev/null
+++ b/tools/ui/src/lib/services/prewarm.service.ts
@@ -0,0 +1,60 @@
+/**
+ * PrewarmService - computes the shared start of every new chat once after the server is ready
+ *
+ * Every chat request starts with the same system message and tool definitions (~1.6k tokens with the server
+ * tools). Sending exactly that start once, with an empty user message, leaves a context checkpoint at the first
+ * user message on the server; the first message of a new chat then reuses it instead of processing it again.
+ * Mirrors the request of the agentic flow (system message from the settings, enabled tools in the same order).
+ */
+
+import { MessageRole } from '$lib/enums';
+import { conversationsStore, mcpStore, modelsStore, settingsStore, toolsStore } from '$lib/stores';
+import { apiPost } from '$lib/utils';
+
+let lastKey: string | null = null;
+
+export class PrewarmService {
+	static async prewarm(): Promise<void> {
+		try {
+			if (
+				toolsStore.serverTools.length === 0 &&
+				!toolsStore.loading &&
+				!toolsStore.isToolsEndpointUnreachable
+			) {
+				await toolsStore.fetchServerTools();
+			}
+
+			// the read-media tool depends on the model list (vision/audio), the send path has it loaded
+			await modelsStore.fetch();
+
+			if (conversationsStore.preferences.policyEnabledServerIds().length > 0) {
+				await mcpStore.ensureInitialized();
+			}
+
+			const tools = toolsStore.getEnabledToolsForLLM();
+			const system = settingsStore.config.systemMessage;
+
+			if (tools.length === 0 && !system) return; // a bare template is too short to matter
+
+			const messages = [
+				...(system ? [{ content: system, role: MessageRole.SYSTEM }] : []),
+				{ content: '', role: MessageRole.USER }
+			];
+			const key = JSON.stringify([messages, tools]);
+
+			if (key === lastKey) return;
+
+			lastKey = key;
+
+			await apiPost('./v1/chat/completions', {
+				max_tokens: 1,
+				messages,
+				stream: false,
+				tools: tools.length > 0 ? tools : undefined
+			});
+		} catch (error) {
+			// only a speed-up: a failed prewarm just means the first message processes the full prompt
+			console.info('[PrewarmService] skipped:', error);
+		}
+	}
+}
