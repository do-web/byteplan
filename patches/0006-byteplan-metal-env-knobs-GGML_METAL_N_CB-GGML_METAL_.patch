From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dominik Weber <doweb85@gmail.com>
Date: Thu, 8 Oct 2026 23:50:27 +0200
Subject: [PATCH 06/27] byteplan: metal env knobs GGML_METAL_N_CB /
 GGML_METAL_N_MAIN for encode overlap tuning

---
 ggml/src/ggml-metal/ggml-metal-context.m | 5 ++++-
 ggml/src/ggml-metal/ggml-metal.cpp       | 7 +++++--
 2 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/ggml/src/ggml-metal/ggml-metal-context.m b/ggml/src/ggml-metal/ggml-metal-context.m
index 0739e46..80b9050 100644
--- a/ggml/src/ggml-metal/ggml-metal-context.m
+++ b/ggml/src/ggml-metal/ggml-metal-context.m
@@ -538,7 +538,10 @@ enum ggml_status ggml_metal_graph_compute(ggml_metal_t ctx, struct ggml_cgraph *
     }
 
     // number of nodes encoded by the main thread (empirically determined)
-    const int n_main = MAX(64, 0.1*gf->n_nodes);
+    // byteplan: GGML_METAL_N_MAIN overrides it (smaller = GPU starts earlier while the rest is encoded)
+    const char * n_main_s = getenv("GGML_METAL_N_MAIN");
+    const int n_main_env = n_main_s ? atoi(n_main_s) : 0;
+    const int n_main = n_main_env > 0 ? n_main_env : MAX(64, 0.1*gf->n_nodes);
 
     // number of threads in addition to the main thread
     const int n_cb = ctx->n_cb;
diff --git a/ggml/src/ggml-metal/ggml-metal.cpp b/ggml/src/ggml-metal/ggml-metal.cpp
index 344882e..7d04222 100644
--- a/ggml/src/ggml-metal/ggml-metal.cpp
+++ b/ggml/src/ggml-metal/ggml-metal.cpp
@@ -630,7 +630,9 @@ ggml_backend_t ggml_backend_metal_init(void) {
         /* .context   = */ ctx,
     };
 
-    ggml_backend_metal_set_n_cb(backend, 1);
+    // byteplan: GGML_METAL_N_CB = extra encoder threads (default 1), to test host-side encode overlap
+    const char * n_cb_env = getenv("GGML_METAL_N_CB");
+    ggml_backend_metal_set_n_cb(backend, n_cb_env ? atoi(n_cb_env) : 1);
 
     return backend;
 }
@@ -725,7 +727,8 @@ static ggml_backend_t ggml_backend_metal_device_init_backend(ggml_backend_dev_t
         /* .context   = */ ctx,
     };
 
-    ggml_backend_metal_set_n_cb(backend, 1);
+    const char * n_cb_env = getenv("GGML_METAL_N_CB"); // byteplan, see ggml_backend_metal_init
+    ggml_backend_metal_set_n_cb(backend, n_cb_env ? atoi(n_cb_env) : 1);
 
     return backend;
 
-- 
2.53.0

