+#include "llama-spar.h"
+
+#include "llama-impl.h"
+
+#include <algorithm>
+#include <chrono>
+#include <climits>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <stdexcept>
+
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static constexpr size_t SPAR_PAGE = 16384;
+static constexpr float  SPAR_HALF_LIFE = 256.0f; // tokens; best in the trace simulation (agent/code/prose)
+static constexpr char   SPAR_MAGIC[8] = {'B', 'P', 'E', 'X', 'P', 'R', 'T', '1'};
+
+template <typename T> static T rd(const uint8_t *& p) {
+    T v;
+    memcpy(&v, p, sizeof(T));
+    p += sizeof(T);
+    return v;
+}
+
+static void read_full(int fd, void * dst, size_t n, uint64_t off) {
+    auto * d = (char *) dst;
+    while (n > 0) {
+        const ssize_t r = pread(fd, d, n, (off_t) off);
+        if (r <= 0) {
+            throw std::runtime_error(format("spar: pread failed at offset %llu", (unsigned long long) off));
+        }
+        d += r; off += (uint64_t) r; n -= (size_t) r;
+    }
+}
+
+static inline void spar_publish() {
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+#if defined(__aarch64__)
+    __asm__ volatile("dsb sy" ::: "memory");
+#endif
+}
+
+void llama_spar::load_header(const std::string & experts_path, int n_layer_model, int n_expert_model, int64_t n_embd, int64_t n_ff) {
+    fd = open(experts_path.c_str(), O_RDONLY);
+    if (fd < 0) {
+        throw std::runtime_error("spar: cannot open " + experts_path);
+    }
+    // ponytail: no page cache. Tried as an elastic second level (a cached read costs 0.06 instead of 0.45 ms, but reads
+    // into the Metal buffer bypass it and a heap bounce copy did): next to the pool and everyday apps macOS kept few
+    // expert pages, +2 % over three sessions for an extra copy per miss. Prefetch hides more (2026-10-09).
+    fcntl(fd, F_NOCACHE, 1);
+
+    std::vector<uint8_t> head(SPAR_PAGE);
+    read_full(fd, head.data(), head.size(), 0);
+    if (memcmp(head.data(), SPAR_MAGIC, 8) != 0) {
+        throw std::runtime_error("spar: " + experts_path + " is not an experts.bin (spar_pack.py)");
+    }
+    const uint8_t * p = head.data() + 8;
+    const uint32_t version = rd<uint32_t>(p);
+    const uint32_t n_lay   = rd<uint32_t>(p);
+    const uint32_t n_exp   = rd<uint32_t>(p);
+    const uint32_t n_mat   = rd<uint32_t>(p);
+    if (version != 1 || n_mat != 3 || n_lay != (uint32_t) n_layer_model || n_exp != (uint32_t) n_expert_model) {
+        throw std::runtime_error(format("spar: experts.bin does not fit the model (version %u, %u matrices, %u layers, %u experts; "
+                                        "model %d layers, %d experts)", version, n_mat, n_lay, n_exp, n_layer_model, n_expert_model));
+    }
+    n_layer  = n_layer_model;
+    n_expert = n_expert_model;
+
+    // every value below sizes a GPU view or a pread: all of them must match the model and stay inside the blob
+    const int64_t want[3][2] = { { n_embd, n_ff }, { n_embd, n_ff }, { n_ff, n_embd } }; // gate, up, down
+    uint64_t end_of_blob = 0;
+    for (int i = 0; i < 3; ++i) {
+        matrix & m = mats[i];
+        const uint32_t type = rd<uint32_t>(p);
+        m.ne0         = (int64_t) rd<uint64_t>(p);
+        m.ne1         = (int64_t) rd<uint64_t>(p);
+        m.slice_bytes = rd<uint64_t>(p);
+        m.offset      = rd<uint64_t>(p);
+        if (type >= GGML_TYPE_COUNT || ggml_type_size((ggml_type) type) == 0 || (i > 0 && type != (uint32_t) mats[0].type) ||
+            m.ne0 != want[i][0] || m.ne1 != want[i][1] || m.ne0 % ggml_blck_size((ggml_type) type) != 0 ||
+            m.slice_bytes != ggml_row_size((ggml_type) type, m.ne0) * (uint64_t) m.ne1 || m.offset != end_of_blob) {
+            throw std::runtime_error(format("spar: experts.bin matrix %d does not fit the model", i));
+        }
+        m.type = (ggml_type) type;
+        end_of_blob = m.offset + m.slice_bytes;
+    }
+    blob_stride = rd<uint64_t>(p);
+    data_offset = rd<uint64_t>(p);
+    // exact values as written by spar_pack.py: no file value can grow the pool size or a read offset
+    if (blob_stride != (end_of_blob + SPAR_PAGE - 1) / SPAR_PAGE * SPAR_PAGE || data_offset != SPAR_PAGE ||
+        (size_t) (p - head.data()) + (size_t) n_layer > head.size()) {
+        throw std::runtime_error("spar: experts.bin has an invalid layout");
+    }
+    present.assign(p, p + n_layer);
+
+    struct stat st = {};
+    if (fstat(fd, &st) != 0 || (uint64_t) st.st_size < data_offset + (uint64_t) n_layer*n_expert*blob_stride) {
+        throw std::runtime_error("spar: experts.bin is truncated");
+    }
+}
+
+bool llama_spar::load_profile(const std::string & path, std::vector<std::vector<float>> & miss, std::vector<std::vector<int>> & rank) const {
+    // a missing or foreign profile only costs speed: fall back to uniform slots and experts 0..S-1
+    FILE * f = fopen(path.c_str(), "rb");
+    if (!f) {
+        return false;
+    }
+    char     magic[8] = {};
+    uint32_t hdr[4]   = {};
+    bool ok = fread(magic, 1, 8, f) == 8 && memcmp(magic, "BPPROF1", 8) == 0 && fread(hdr, 4, 4, f) == 4 &&
+              hdr[0] == 1 && hdr[1] == (uint32_t) n_layer && hdr[2] == (uint32_t) n_expert;
+    miss.assign(n_layer, std::vector<float>(n_expert + 1));
+    rank.assign(n_layer, std::vector<int>(n_expert));
+    std::vector<uint16_t> r(n_expert);
+    std::vector<char>     seen(n_expert);
+    for (int il = 0; ok && il < n_layer; ++il) {
+        ok = fread(miss[il].data(), 4, n_expert + 1, f) == (size_t) n_expert + 1 && fread(r.data(), 2, n_expert, f) == (size_t) n_expert;
+        std::fill(seen.begin(), seen.end(), 0);
+        for (int i = 0; ok && i < n_expert; ++i) {
+            ok = r[i] < n_expert && !seen[r[i]] && std::isfinite(miss[il][i]) && miss[il][i] >= 0.0f;
+            seen[ok ? r[i] : 0] = 1;
+            rank[il][i] = r[i];
+        }
+    }
+    ok = ok && fgetc(f) == EOF;
+    fclose(f);
+    if (!ok) {
+        LLAMA_LOG_WARN("%s: ignoring %s (does not match experts.bin)\n", __func__, path.c_str());
+    }
+    return ok;
+}
+
+void llama_spar::release() {
+    if (buf) {
+        ggml_backend_buffer_free(buf);
+        buf = nullptr;
+    }
+    if (ctx) {
+        ggml_free(ctx);
+        ctx = nullptr;
+    }
+    if (fd >= 0) {
+        close(fd);
+        fd = -1;
+    }
+
+}
+
+llama_spar::llama_spar(const std::string & experts_path, int n_layer_model, int n_expert_model, int64_t n_embd, int64_t n_ff,
+                       int n_expert_used, int n_slots, int n_ubatch, bool load,
+                       llama_progress_callback progress, void * progress_user_data) {
+    try {
+        init(experts_path, n_layer_model, n_expert_model, n_embd, n_ff, n_expert_used, n_slots, n_ubatch, load, progress, progress_user_data);
+    } catch (...) {
+        release(); // the destructor does not run for a throwing constructor
+        throw;
+    }
+}
+
+void llama_spar::init(const std::string & experts_path, int n_layer_model, int n_expert_model, int64_t n_embd, int64_t n_ff,
+                      int n_expert_used, int n_slots_req, int n_ubatch, bool load,
+                      llama_progress_callback progress, void * progress_user_data) {
+    load_header(experts_path, n_layer_model, n_expert_model, n_embd, n_ff);
+
+    n_slots = n_slots_req <= 0 ? n_expert : std::min(n_slots_req, n_expert);
+    k       = n_expert_used;
+    t_max   = n_ubatch;
+    // seq/gate/ntok sit at fixed offsets 64 apart; ntok shares its word with the pass (bits 16+)
+    if (k <= 0 || t_max <= 0 || t_max >= 65536 || n_layer > 64 || n_slots < k) {
+        throw std::runtime_error(format("spar: unsupported setup (%d layers, n_ubatch %d, %d slots for top-%d)", n_layer, n_ubatch, n_slots, k));
+    }
+
+    // optional profile (tools/experts/profile.py): slots per layer by marginal misses saved (steps of 16, floor 48,
+    // total never above n_slots per layer) and the most used experts as the initial working set
+    std::vector<std::vector<float>> miss;
+    std::vector<std::vector<int>>   rank;
+    const bool profiled = n_slots < n_expert && getenv("BYTEPLAN_SPAR_NOPROFILE") == nullptr &&
+                          load_profile(experts_path + ".profile", miss, rank);
+    layer_slots.assign(n_layer, n_slots);
+    if (profiled) {
+        constexpr int step = 16;
+        const int floor_s  = std::min(n_expert, std::max(48, k));
+        int64_t budget = 0, used = 0;
+        for (int il = 0; il < n_layer; ++il) {
+            if (present[il]) {
+                budget += n_slots;
+                layer_slots[il] = floor_s;
+                used += floor_s;
+            }
+        }
+        while (true) {
+            int best = -1;
+            float gain = 0.0f;
+            for (int il = 0; il < n_layer; ++il) {
+                const int s = layer_slots[il];
+                if (present[il] && s + step <= n_expert && used + step <= budget && miss[il][s] - miss[il][s + step] > gain) {
+                    best = il;
+                    gain = miss[il][s] - miss[il][s + step];
+                }
+            }
+            if (best < 0) {
+                break;
+            }
+            layer_slots[best] += step;
+            used += step;
+        }
+    }
+    const int max_slots = *std::max_element(layer_slots.begin(), layer_slots.end());
+
+    // control block layout in uint32 units; the size is checked in 64 bit before anything is allocated
+    const int64_t n_mirror = (int64_t) k * t_max;
+    const int64_t n_hint   = (int64_t) SPAR_HINT_N * SPAR_HINT_T;
+    const int64_t n_ctrl64 = off_remap + (int64_t) n_layer*n_expert + n_layer*(1 + std::min<int64_t>(max_slots, n_mirror)) + n_layer*n_mirror + n_layer*n_hint;
+    if (n_ctrl64 > INT32_MAX) {
+        throw std::runtime_error("spar: control block too large (n_ubatch)");
+    }
+    off_refresh    = off_remap + n_layer*n_expert;
+    refresh_stride = 1 + (int) std::min<int64_t>(max_slots, n_mirror);
+    off_mirror     = off_refresh + n_layer*refresh_stride;
+    mirror_stride  = (int) n_mirror;
+    off_hint       = off_mirror + n_layer*mirror_stride;
+    hint_stride    = (int) n_hint;
+    n_ctrl         = (int) n_ctrl64;
+    // the hint costs ~3 % (an extra router matmul per layer): worth it only with many misses (S=460: +-0, 410: +1 %,
+    // 358: +6 %), so it is on below 85 % slots unless BYTEPLAN_SPAR_PREFETCH=0/1 says otherwise
+    const char * pf_env = getenv("BYTEPLAN_SPAR_PREFETCH");
+    prefetch_on    = max_slots < n_expert && (pf_env ? atoi(pf_env) != 0 : n_slots * 100 < n_expert * 85);
+    if (const char * v = getenv("BYTEPLAN_SPAR_PF_RANKS")) { pf_ranks = std::max(1, atoi(v)); }
+    if (const char * v = getenv("BYTEPLAN_SPAR_PF_MAX"))   { pf_max   = std::max(1, atoi(v)); }
+    if (const char * v = getenv("BYTEPLAN_SPAR_PF_IO"))    { pf_io    = std::max(1, atoi(v)); }
+    if (const char * v = getenv("BYTEPLAN_SPAR_PF_AHEAD")) { pf_ahead = std::clamp(atoi(v), 1, 2); }
+    stats = getenv("BYTEPLAN_SPAR_STATS") != nullptr;
+    const char * lim = getenv("BYTEPLAN_SPAR_LIMIT");
+    limit = lim ? atoi(lim) : 2000000;
+
+    ggml_init_params ip = { ggml_tensor_overhead() * (size_t) (n_layer + 2), nullptr, true };
+    ctx = ggml_init(ip);
+    ctrl = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, n_ctrl);
+    ggml_set_name(ctrl, "spar_ctrl");
+    pool.assign(n_layer, nullptr);
+    for (int il = 0; il < n_layer; ++il) {
+        if (!present[il]) {
+            continue;
+        }
+        const ggml_type type  = mats[0].type;
+        const size_t    bytes = SPAR_PAGE + (size_t) layer_slots[il] * blob_stride;
+        const int64_t   ne    = (int64_t) ((bytes + ggml_type_size(type) - 1) / ggml_type_size(type)) * ggml_blck_size(type);
+        pool[il] = ggml_new_tensor_1d(ctx, type, ne);
+        ggml_format_name(pool[il], "spar_pool.%d", il);
+    }
+
+    ggml_backend_dev_t gpu = nullptr;
+    for (size_t i = 0; i < ggml_backend_dev_count() && !gpu; ++i) {
+        ggml_backend_dev_t d = ggml_backend_dev_get(i);
+        if (ggml_backend_dev_type(d) == GGML_BACKEND_DEVICE_TYPE_GPU || ggml_backend_dev_type(d) == GGML_BACKEND_DEVICE_TYPE_IGPU) {
+            gpu = d;
+        }
+    }
+    if (!gpu) {
+        throw std::runtime_error("spar: needs a GPU (Metal) device");
+    }
+    buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx, ggml_backend_dev_buffer_type(gpu));
+    if (!buf) {
+        throw std::runtime_error("spar: pool allocation failed");
+    }
+
+    // the CPU writes the pool and the control block directly: the buffer must be shared (unified memory)
+    memset(ctrl->data, 0, ggml_nbytes(ctrl));
+    *c(off_hb) = 0x5ba5u;
+    int32_t probe = 0;
+    ggml_backend_tensor_get(ctrl, &probe, (size_t) off_hb * sizeof(int32_t), sizeof(probe));
+    if ((uint32_t) probe != 0x5ba5u) {
+        throw std::runtime_error("spar: the GPU buffer is not CPU-visible (needs shared Metal buffers)");
+    }
+    *c(off_hb) = 0;
+
+    pad.assign(n_layer, 0);
+    state.resize(n_layer);
+    served.assign(n_layer, 0);
+    hint_served.assign(n_layer, 0);
+    inflight = std::make_unique<std::atomic<int>[]>(n_layer);
+    done_slots.resize(n_layer);
+    for (int il = 0; il < n_layer; ++il) {
+        if (!pool[il]) {
+            continue;
+        }
+        pad[il] = (SPAR_PAGE - (uintptr_t) pool[il]->data % SPAR_PAGE) % SPAR_PAGE;
+        state[il].slot_of.assign(n_expert, -1);
+        state[il].expert_of.assign(layer_slots[il], -1);
+        state[il].last_use.assign(layer_slots[il], 0);
+        state[il].prefetched.assign(layer_slots[il], 0);
+        state[il].loading.assign(layer_slots[il], 0);
+        state[il].score.assign(n_expert, 0.0f);
+        state[il].score_tok.assign(n_expert, 0);
+    }
+
+    if (!load) {
+        return;
+    }
+
+    // initial working set: the most used experts (profile) or 0..S-1 of every layer, read in parallel
+    const auto t0 = std::chrono::steady_clock::now();
+    std::vector<std::thread> loaders;
+    std::atomic<int>  next{0}, done{0};
+    std::atomic<bool> failed{false};
+    for (int t = 0; t < 8; ++t) {
+        loaders.emplace_back([&] {
+            try {
+                for (int il; !failed && (il = next++) < n_layer; ) {
+                    if (!pool[il]) {
+                        done++;
+                        continue;
+                    }
+                    for (int s = 0; s < layer_slots[il]; ++s) {
+                        const int e = profiled ? rank[il][s] : s;
+                        read_full(fd, slot_ptr(il, s), blob_stride, data_offset + ((uint64_t) il*n_expert + e)*blob_stride);
+                        state[il].slot_of[e]   = s;
+                        state[il].expert_of[s] = e;
+                        *c(off_remap + il*n_expert + e) = (uint32_t) s;
+                    }
+                    done++;
+                }
+            } catch (const std::exception &) {
+                failed = true;
+            }
+        });
+    }
+    // progress for the caller (llama-server shows it while loading), 5 updates per second
+    while (progress && done < n_layer && !failed) {
+        progress((float) done / n_layer, progress_user_data);
+        std::this_thread::sleep_for(std::chrono::milliseconds(200));
+    }
+    for (auto & t : loaders) {
+        t.join();
+    }
+    if (progress) {
+        progress(1.0f, progress_user_data);
+    }
+    if (failed) {
+        throw std::runtime_error("spar: reading the initial experts failed");
+    }
+    spar_publish();
+    const double dt = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+    LLAMA_LOG_INFO("%s: %d slots x %d layers (%s, %d..%d per layer, %.2f GiB pool), %s, preload %.1f s\n", __func__, n_slots, n_layer,
+                   profiled ? "profile" : "uniform", *std::min_element(layer_slots.begin(), layer_slots.end()), max_slots,
+                   ggml_backend_buffer_get_size(buf) / 1073741824.0, experts_path.c_str(), dt);
+
+    if (prefetch_on) {
+        for (int t = 0; t < pf_io; ++t) {
+            io_threads.emplace_back([this] { io_loop(); });
+        }
+    }
+    worker = std::thread([this] { run(); });
+}
+
+llama_spar::~llama_spar() {
+    stop = true;
+    if (worker.joinable()) {
+        worker.join();
+    }
+    {
+        std::lock_guard<std::mutex> lock(io_mu);
+        io_q.clear();
+    }
+    io_cv.notify_all();
+    for (auto & t : io_threads) {
+        t.join();
+    }
+    release();
+    LLAMA_LOG_INFO("%s: %llu requests, %llu misses, %.2f GiB read\n", __func__, (unsigned long long) n_requests.load(),
+                   (unsigned long long) n_misses.load(), bytes_read.load() / 1073741824.0);
+    if (stats && n_hint > 0) {
+        LLAMA_LOG_WARN("spar stats: %llu hints, %llu prefetched, %llu of them used, %.3f ms waiting for prefetches\n",
+                       (unsigned long long) n_hint, (unsigned long long) n_prefetch, (unsigned long long) n_prefetch_used,
+                       t_inflight_wait / 1e6);
+    }
+    if (stats && n_requests > 0) {
+        LLAMA_LOG_WARN("spar stats: %llu requests, %llu with misses (%.3f ms each in the worker), %llu misses; "
+                       "per request: plan+victims %.3f ms, io %.3f ms, publish %.3f ms; misses/request 0:%llu 1:%llu 2:%llu 3:%llu 4-7:%llu 8+:%llu\n",
+                       (unsigned long long) n_requests.load(), (unsigned long long) n_req_miss,
+                       n_req_miss ? t_req_miss / 1e6 / n_req_miss : 0.0, (unsigned long long) n_misses.load(),
+                       t_plan / 1e6 / n_requests, t_io / 1e6 / n_requests, t_publish / 1e6 / n_requests,
+                       (unsigned long long) miss_hist[0], (unsigned long long) miss_hist[1], (unsigned long long) miss_hist[2],
+                       (unsigned long long) miss_hist[3], (unsigned long long) miss_hist[4], (unsigned long long) miss_hist[5]);
+    }
+}
+
+bool llama_spar::has_layer(int il) const {
+    return il >= 0 && il < n_layer && pool[il] != nullptr;
+}
+
+void llama_spar::params(int il, int32_t * p) const {
+    p[GGML_SPAR_P_MODE]           = 0;
+    p[GGML_SPAR_P_LAYER]          = il;
+    p[GGML_SPAR_P_OFF_SEQ]        = off_seq;
+    p[GGML_SPAR_P_OFF_GATE]       = off_gate;
+    p[GGML_SPAR_P_OFF_NTOK]       = off_ntok;
+    p[GGML_SPAR_P_OFF_MIRROR]     = off_mirror;
+    p[GGML_SPAR_P_MIRROR_STRIDE]  = mirror_stride;
+    p[GGML_SPAR_P_OFF_REMAP]      = off_remap;
+    p[GGML_SPAR_P_N_EXPERT]       = n_expert;
+    p[GGML_SPAR_P_OFF_REFRESH]    = off_refresh;
+    p[GGML_SPAR_P_REFRESH_STRIDE] = refresh_stride;
+    p[GGML_SPAR_P_OFF_HB]         = off_hb;
+    p[GGML_SPAR_P_OFF_ABORT]      = off_abort;
+    p[GGML_SPAR_P_LIMIT]          = limit;
+    p[GGML_SPAR_P_BLOB_WORDS]     = (int32_t) (blob_stride / 4);
+    p[GGML_SPAR_P_OFF_TIMEOUTS]   = off_timeouts;
+}
+
+ggml_tensor * llama_spar::slots(ggml_context * ctx0, int il) const {
+    const ggml_type type = pool[il]->type;
+    return ggml_view_1d(ctx0, pool[il], (int64_t) ((size_t) layer_slots[il] * blob_stride / ggml_type_size(type)) * ggml_blck_size(type), pad[il]);
+}
+
+bool llama_spar::hint_enabled(int il, int64_t n_tokens) const {
+    return prefetch_on && has_layer(il) && layer_slots[il] < n_expert && n_tokens <= SPAR_HINT_T && n_pass(il, n_tokens) == 1;
+}
+
+void llama_spar::hint_params(int il, int32_t * p) const {
+    params(il, p);
+    p[GGML_SPAR_P_OFF_SEQ]       = off_hint_seq;
+    p[GGML_SPAR_P_OFF_NTOK]      = off_hint_ntok;
+    p[GGML_SPAR_P_OFF_MIRROR]    = off_hint;
+    p[GGML_SPAR_P_MIRROR_STRIDE] = hint_stride;
+}
+
+int llama_spar::n_pass(int il, int64_t n_tokens) const {
+    const int64_t need = std::min<int64_t>((int64_t) k * n_tokens, n_expert);
+    return (int) std::max<int64_t>(1, (need + layer_slots[il] - 1) / layer_slots[il]);
+}
+
+ggml_tensor * llama_spar::view(ggml_context * ctx0, int il, int mat) const {
+    const matrix & m = mats[mat];
+    return ggml_view_3d(ctx0, pool[il], m.ne0, m.ne1, layer_slots[il], ggml_row_size(m.type, m.ne0), blob_stride, pad[il] + m.offset);
+}
+
+void llama_spar::check() const {
+    // no exception: this runs in llama_context::synchronize, also from the destructor and behind the C API
+    if (*c(off_abort) != 0) {
+        GGML_ABORT("spar: the GPU gave up waiting for the expert loader (%u timeouts); the last pass is invalid", *c(off_timeouts));
+    }
+}
+
+char * llama_spar::slot_ptr(int il, int slot) const {
+    return (char *) pool[il]->data + pad[il] + (size_t) slot * blob_stride;
+}
+
+volatile uint32_t * llama_spar::c(int off) const {
+    return (volatile uint32_t *) ctrl->data + off;
+}
+
+float llama_spar::score_now(const layer_state & st, int e) {
+    return st.score[e] * exp2f(-(float) (st.tok - st.score_tok[e]) / SPAR_HALF_LIFE);
+}
+
+void llama_spar::plan(int il, int n_tokens) {
+    auto & st = state[il];
+    volatile uint32_t * ids = c(off_mirror + il*mirror_stride);
+
+    // distinct experts in order of first use; residents first so pass 0 needs the fewest reads
+    static thread_local std::vector<char> seen;
+    seen.assign(n_expert, 0);
+    std::vector<int32_t> resident, missing;
+    st.tok += (uint64_t) n_tokens;
+    for (int i = 0; i < n_tokens*k; ++i) {
+        const uint32_t e = ids[i];
+        if (e >= (uint32_t) n_expert) {
+            throw std::runtime_error(format("spar: layer %d: expert id %u out of range", il, e));
+        }
+        st.score[e]     = score_now(st, (int) e) + 1.0f; // one use per token
+        st.score_tok[e] = st.tok;
+        if (!seen[e]) {
+            seen[e] = 1;
+            (st.slot_of[e] >= 0 ? resident : missing).push_back((int32_t) e);
+        }
+    }
+    st.distinct = resident;
+    st.distinct.insert(st.distinct.end(), missing.begin(), missing.end());
+
+    st.groups.clear();
+    const size_t S = (size_t) layer_slots[il];
+    for (size_t i = 0; i < st.distinct.size(); i += S) {
+        st.groups.emplace_back(st.distinct.begin() + i, st.distinct.begin() + std::min(st.distinct.size(), i + S));
+    }
+    if ((int) st.groups.size() > n_pass(il, n_tokens)) {
+        throw std::runtime_error(format("spar: layer %d: %zu groups but the graph has %d passes", il, st.groups.size(), n_pass(il, n_tokens)));
+    }
+}
+
+void llama_spar::serve(int il, uint32_t seq) {
+    using clk = std::chrono::steady_clock;
+    const auto ns = [](clk::time_point a, clk::time_point b) { return (uint64_t) std::chrono::duration_cast<std::chrono::nanoseconds>(b - a).count(); };
+    const auto t0 = clk::now();
+    auto & st = state[il];
+
+    // finished background prefetches of this layer join this request's refresh list
+    std::vector<int> pending;
+    const auto take_done = [&] {
+        std::lock_guard<std::mutex> lock(io_mu);
+        for (const int s : done_slots[il]) {
+            st.loading[s] = 0;
+            pending.push_back(s);
+        }
+        done_slots[il].clear();
+    };
+    if (prefetch_on) {
+        take_done();
+    }
+    const uint32_t word = *c(off_ntok + il);
+    const int n    = (int) (word & 0xffffu);
+    const int pass = (int) (word >> 16);
+    if (n > t_max || (pass != 0 && pass != st.pass + 1)) {
+        throw std::runtime_error(format("spar: layer %d: invalid request (%d tokens, pass %d after %d)", il, n, pass, st.pass));
+    }
+    st.pass = pass;
+    if (pass == 0) {
+        plan(il, n);
+    }
+    static const std::vector<int32_t> none;
+    const std::vector<int32_t> & group = pass < (int) st.groups.size() ? st.groups[pass] : none;
+
+    // only reads this pass needs are awaited; other prefetches keep running (their slots are never victims)
+    if (prefetch_on) {
+        const auto tw = clk::now();
+        while (true) {
+            if (io_failed) {
+                throw std::runtime_error(format("spar: layer %d: prefetch read failed", il));
+            }
+            bool busy_slot = false;
+            for (const int32_t e : group) {
+                busy_slot = busy_slot || (st.slot_of[e] >= 0 && st.loading[st.slot_of[e]]);
+            }
+            if (!busy_slot) {
+                break;
+            }
+            std::this_thread::yield();
+            take_done();
+        }
+        t_inflight_wait += ns(tw, clk::now());
+    }
+    ++clock;
+
+    // the group is pinned (last_use == clock), victims come only from slots outside it
+    for (const int32_t e : group) {
+        if (st.slot_of[e] >= 0) {
+            st.last_use[st.slot_of[e]] = clock;
+            if (st.prefetched[st.slot_of[e]]) {
+                st.prefetched[st.slot_of[e]] = 0;
+                n_prefetch_used++;
+            }
+        }
+    }
+    std::vector<std::pair<int, int32_t>> jobs; // slot, expert
+    for (const int32_t e : group) {
+        if (st.slot_of[e] >= 0) {
+            continue;
+        }
+        int   victim = -1;
+        float v_score = 0.0f;
+        for (int s = 0; s < layer_slots[il]; ++s) {
+            if (st.last_use[s] == clock || st.loading[s]) {
+                continue; // pinned: part of this pass, or a background read is filling it
+            }
+            const float sc = st.expert_of[s] >= 0 ? score_now(st, st.expert_of[s]) : -1.0f;
+            if (victim < 0 || sc < v_score || (sc == v_score && st.last_use[s] < st.last_use[victim])) {
+                victim  = s;
+                v_score = sc;
+            }
+        }
+        if (victim < 0) {
+            throw std::runtime_error(format("spar: layer %d: no free slot", il));
+        }
+        if (st.expert_of[victim] >= 0) {
+            st.slot_of[st.expert_of[victim]] = -1;
+        }
+        st.slot_of[e]         = victim;
+        st.expert_of[victim]  = e;
+        st.last_use[victim]   = clock;
+        st.prefetched[victim] = 0;
+        jobs.emplace_back(victim, e);
+    }
+
+    const auto t1 = clk::now();
+
+    // parallel reads: one pread per expert, the SSD needs several in flight
+    std::atomic<size_t> next{0};
+    std::atomic<bool>   failed{false};
+    const auto reader = [&] {
+        try {
+            for (size_t j; !failed && (j = next++) < jobs.size(); ) {
+                read_full(fd, slot_ptr(il, jobs[j].first), blob_stride, data_offset + ((uint64_t) il*n_expert + jobs[j].second)*blob_stride);
+                __atomic_fetch_add(const_cast<uint32_t *>(c(off_hb)), 1u, __ATOMIC_RELAXED); // progress: the GPU keeps waiting
+            }
+        } catch (const std::exception &) {
+            failed = true;
+        }
+    };
+    std::vector<std::thread> io;
+    for (size_t t = 1; t < std::min<size_t>(8, jobs.size()); ++t) {
+        io.emplace_back(reader);
+    }
+    reader();
+    for (auto & t : io) {
+        t.join();
+    }
+    if (failed) {
+        throw std::runtime_error(format("spar: layer %d: reading experts failed", il));
+    }
+
+    const auto t2 = clk::now();
+
+    // every expert of the ubatch gets a fresh entry: its slot in this pass or -1 (skipped by MUL_MAT_ID)
+    volatile uint32_t * remap   = c(off_remap + il*n_expert);
+    volatile uint32_t * refresh = c(off_refresh + il*refresh_stride);
+    for (const int32_t e : st.distinct) {
+        remap[e] = 0xffffffffu;
+    }
+    for (const int32_t e : group) {
+        remap[e] = (uint32_t) st.slot_of[e];
+    }
+    // refilled slots: demand reads and finished prefetches, each once
+    static thread_local std::vector<char> listed;
+    listed.assign(layer_slots[il], 0);
+    uint32_t n_refresh = 0;
+    for (const auto & j : jobs) {
+        pending.push_back(j.first);
+    }
+    for (const int s : pending) {
+        if (!listed[s]) {
+            listed[s] = 1;
+            refresh[1 + n_refresh++] = (uint32_t) s;
+        }
+    }
+    refresh[0] = n_refresh;
+
+    spar_publish();
+    *c(off_gate + il) = seq;
+    spar_publish();
+
+    if (stats) {
+        const auto t3 = clk::now();
+        t_plan += ns(t0, t1); t_io += ns(t1, t2); t_publish += ns(t2, t3);
+        miss_hist[jobs.size() >= 8 ? 5 : jobs.size() >= 4 ? 4 : jobs.size()]++;
+        if (!jobs.empty()) {
+            n_req_miss++;
+            t_req_miss += ns(t0, t3);
+        }
+    }
+    n_requests++;
+    n_misses   += jobs.size();
+    bytes_read += jobs.size() * blob_stride;
+}
+
+void llama_spar::prefetch(int il) {
+    auto & st = state[il];
+    const uint32_t word = *c(off_hint_ntok + il);
+    const int T = (int) (word & 0xffffu), N = (int) (word >> 16);
+    if (T <= 0 || T > SPAR_HINT_T || N <= 0 || N > SPAR_HINT_N) {
+        throw std::runtime_error(format("spar: layer %d: invalid hint (%d tokens x %d)", il, T, N));
+    }
+    volatile uint32_t * h = c(off_hint + il*hint_stride);
+    n_hint++;
+
+    // predicted experts that are not resident, best ranks of all tokens first; a few per layer keep the SSD free
+    // for demand reads
+    std::vector<int32_t> want;
+    for (int r = 0; r < std::min(N, pf_ranks) && (int) want.size() < pf_max; ++r) {
+        for (int t = 0; t < T && (int) want.size() < pf_max; ++t) {
+            const uint32_t e = h[t*N + r];
+            if (e >= (uint32_t) n_expert) {
+                throw std::runtime_error(format("spar: layer %d: hint expert id %u out of range", il, e));
+            }
+            if (st.slot_of[e] < 0 && std::find(want.begin(), want.end(), (int32_t) e) == want.end()) {
+                want.push_back((int32_t) e);
+            }
+        }
+    }
+    if (want.empty()) {
+        return;
+    }
+    std::vector<io_job> jobs;
+    for (const int32_t e : want) {
+        int   victim = -1;
+        float v_score = 0.0f;
+        for (int s = 0; s < layer_slots[il]; ++s) {
+            if (st.loading[s]) {
+                continue;
+            }
+            const float sc = st.expert_of[s] >= 0 ? score_now(st, st.expert_of[s]) : -1.0f;
+            if (victim < 0 || sc < v_score || (sc == v_score && st.last_use[s] < st.last_use[victim])) {
+                victim  = s;
+                v_score = sc;
+            }
+        }
+        if (victim < 0) {
+            break;
+        }
+        if (st.expert_of[victim] >= 0) {
+            st.slot_of[st.expert_of[victim]] = -1;
+        }
+        st.slot_of[e]         = victim;
+        st.expert_of[victim]  = e;
+        st.last_use[victim]   = clock;
+        st.loading[victim]    = 1;
+        st.prefetched[victim] = 1;
+        jobs.push_back({ il, victim, e });
+    }
+    inflight[il].fetch_add((int) jobs.size(), std::memory_order_relaxed);
+    {
+        std::lock_guard<std::mutex> lock(io_mu);
+        io_q.insert(io_q.end(), jobs.begin(), jobs.end());
+    }
+    io_cv.notify_all();
+    n_prefetch += jobs.size();
+}
+
+void llama_spar::io_loop() {
+    while (true) {
+        io_job job;
+        {
+            std::unique_lock<std::mutex> lock(io_mu);
+            io_cv.wait(lock, [this] { return stop.load() || !io_q.empty(); });
+            if (io_q.empty()) {
+                return; // stop
+            }
+            job = io_q.front();
+            io_q.pop_front();
+        }
+        try {
+            read_full(fd, slot_ptr(job.il, job.slot), blob_stride, data_offset + ((uint64_t) job.il*n_expert + job.expert)*blob_stride);
+        } catch (const std::exception &) {
+            io_failed = true;
+        }
+        {
+            std::lock_guard<std::mutex> lock(io_mu);
+            done_slots[job.il].push_back(job.slot);
+        }
+        inflight[job.il].fetch_sub(1, std::memory_order_release);
+        __atomic_fetch_add(const_cast<uint32_t *>(c(off_hb)), 1u, __ATOMIC_RELAXED);
+    }
+}
+
+void llama_spar::run() {
+    using clk = std::chrono::steady_clock;
+    auto last_active = clk::now();
+    while (!stop.load(std::memory_order_relaxed)) {
+        bool busy = false;
+        for (int il = 0; il < n_layer; ++il) {
+            if (!pool[il]) {
+                continue;
+            }
+            const uint32_t seq = *c(off_seq + il);
+            if (seq != served[il]) {
+                __atomic_thread_fence(__ATOMIC_ACQUIRE);
+                try {
+                    serve(il, seq);
+                } catch (const std::exception & err) {
+                    LLAMA_LOG_ERROR("%s: %s\n", __func__, err.what());
+                    *c(off_abort) = 1;
+                }
+                served[il] = seq; // also after an abort, so a failed request is not retried in a loop
+                busy = true;
+            }
+        }
+        for (int il = 0; prefetch_on && il < n_layer; ++il) {
+            const uint32_t hseq = *c(off_hint_seq + il);
+            if (hseq != hint_served[il] && pool[il]) {
+                hint_served[il] = hseq;
+                __atomic_thread_fence(__ATOMIC_ACQUIRE);
+                try {
+                    prefetch(il);
+                } catch (const std::exception & err) {
+                    LLAMA_LOG_ERROR("%s: %s\n", __func__, err.what());
+                    *c(off_abort) = 1;
+                }
+                busy = true;
+            }
+        }
+        *c(off_hb) = *c(off_hb) + 1; // heartbeat: while this moves the GPU keeps waiting
+        if (busy) {
+            last_active = clk::now();
+        } else if (clk::now() - last_active > std::chrono::milliseconds(50)) {
+            std::this_thread::sleep_for(std::chrono::microseconds(100));
+        }
+    }
+}
