+struct ggml_tensor * ggml_mul_mat_id_into(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * as,
+        struct ggml_tensor  * b,
+        struct ggml_tensor  * ids,
+        struct ggml_tensor  * acc) {
+    struct ggml_tensor * base = acc->view_src ? acc->view_src : acc;
+    GGML_ASSERT(base->op == GGML_OP_MUL_MAT_ID && acc->view_offs == 0 && ggml_are_same_layout(acc, base));
+    GGML_ASSERT(base->src[0]->ne[2] == as->ne[2] && base->src[2]->ne[1] == ids->ne[1]); // same slots, same tokens
+    GGML_ASSERT(!ggml_is_transposed(as) && ids->type == GGML_TYPE_I32 && as->ne[0] == b->ne[0] && ids->ne[1] == b->ne[2]);
+    GGML_ASSERT(acc->ne[0] == as->ne[1] && acc->ne[1] == ids->ne[0] && acc->ne[2] == b->ne[2] && acc->ne[3] == 1);
+
+    // the result aliases acc (like an inplace op); src[3] orders it after the previous writer
+    struct ggml_tensor * result = ggml_view_tensor(ctx, acc);
+
+    result->op     = GGML_OP_MUL_MAT_ID;
+    result->src[0] = as;
+    result->src[1] = b;
+    result->src[2] = ids;
+    result->src[3] = acc;
+
+    return result;
+}
