+    // byteplan expert pool ("spar", Metal only): a CPU thread streams routed experts into a slot pool, the GPU
+    // synchronizes with it through `ctrl`, an I32 control block in a shared buffer (layout in the params below).
+    //   ggml_spar_wait: publishes ids [k, n_tokens] of a layer, then spins (bounded) until the CPU released the layer;
+    //                   returns a 1-element I32 dependency for ggml_spar_map
+    //   ggml_spar_map:  refreshes the slots the CPU refilled (system-coherent) and maps expert ids -> slot ids
+    enum ggml_spar_param {
+        GGML_SPAR_P_MODE,           // bits 0-7: 0 wait, 1 map, 2 hint (set by the constructors); bits 8+: pass
+        GGML_SPAR_P_LAYER,
+        GGML_SPAR_P_OFF_SEQ,        // offsets are in int32 units into ctrl
+        GGML_SPAR_P_OFF_GATE,
+        GGML_SPAR_P_OFF_NTOK,
+        GGML_SPAR_P_OFF_MIRROR,     // + layer * MIRROR_STRIDE
+        GGML_SPAR_P_MIRROR_STRIDE,
+        GGML_SPAR_P_OFF_REMAP,      // + layer * N_EXPERT
+        GGML_SPAR_P_N_EXPERT,
+        GGML_SPAR_P_OFF_REFRESH,    // + layer * REFRESH_STRIDE: [count, slot...]
+        GGML_SPAR_P_REFRESH_STRIDE,
+        GGML_SPAR_P_OFF_HB,         // CPU heartbeat
+        GGML_SPAR_P_OFF_ABORT,
+        GGML_SPAR_P_LIMIT,          // polls without a heartbeat change before giving up
+        GGML_SPAR_P_BLOB_WORDS,     // slot size in uint32 words
+        GGML_SPAR_P_OFF_TIMEOUTS,
+        GGML_SPAR_N_PARAMS,
+    };
+
+    // pass: multi-pass MoE (a layer's experts in groups of S slots), after: optional dependency, the wait runs on the
