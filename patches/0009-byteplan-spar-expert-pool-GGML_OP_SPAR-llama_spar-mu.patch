+// ggml_spar_wait / ggml_spar_map (byteplan expert pool)
+
+static void ggml_spar_set_params(struct ggml_tensor * t, const int32_t * params, int32_t mode) {
+    int32_t p[GGML_SPAR_N_PARAMS];
+    memcpy(p, params, sizeof(p));
+    p[GGML_SPAR_P_MODE] = mode;
+    ggml_set_op_params(t, p, sizeof(p));
+}
+
+struct ggml_tensor * ggml_spar_wait(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * ids,
+        struct ggml_tensor  * ctrl,
+        const int32_t       * params,
+        int32_t               pass,
+        struct ggml_tensor  * after) {
+    GGML_ASSERT(ids->type == GGML_TYPE_I32 && ids->ne[2] == 1 && ids->ne[3] == 1);
+    GGML_ASSERT(ctrl->type == GGML_TYPE_I32);
+    GGML_ASSERT(pass >= 0 && pass < (1 << 15));
+
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 1);
+
+    ggml_spar_set_params(result, params, 0 | (pass << 8));
+    result->op     = GGML_OP_SPAR;
+    result->src[0] = ids;
+    result->src[1] = ctrl;
+    result->src[2] = after;
+
+    return result;
+}
+
+struct ggml_tensor * ggml_spar_hint(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * ids,
+        struct ggml_tensor  * ctrl,
+        const int32_t       * params) {
+    GGML_ASSERT(ids->type == GGML_TYPE_I32 && ids->ne[2] == 1 && ids->ne[3] == 1);
+    GGML_ASSERT(ctrl->type == GGML_TYPE_I32);
+
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 1);
+
+    ggml_spar_set_params(result, params, 2);
+    result->op     = GGML_OP_SPAR;
+    result->src[0] = ids;
+    result->src[1] = ctrl;
+
+    return result;
+}
+
+struct ggml_tensor * ggml_spar_map(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * ids,
+        struct ggml_tensor  * ctrl,
+        struct ggml_tensor  * wait,
+        struct ggml_tensor  * pool,
+        const int32_t       * params) {
+    GGML_ASSERT(ids->type == GGML_TYPE_I32 && ids->ne[2] == 1 && ids->ne[3] == 1);
+    GGML_ASSERT(ctrl->type == GGML_TYPE_I32 && wait->op == GGML_OP_SPAR);
+
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, ids->ne[0], ids->ne[1]);
+
+    ggml_spar_set_params(result, params, 1);
+    result->op     = GGML_OP_SPAR;
+    result->src[0] = ids;
+    result->src[1] = ctrl;
+    result->src[2] = wait;
+    result->src[3] = pool;
+
+    return result;
+}
