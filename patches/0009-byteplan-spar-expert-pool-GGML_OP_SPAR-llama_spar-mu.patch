+// byteplan expert pool: mode 0 waits (one thread, bounded spin), mode 1 refreshes refilled slots and maps ids -> slots
+int ggml_metal_op_spar(ggml_metal_op_t ctx, int idx) {
+    ggml_tensor * op = ctx->node(idx);
+
+    ggml_metal_library_t lib = ctx->lib;
+    ggml_metal_encoder_t enc = ctx->enc;
+
+    const int32_t * p   = (const int32_t *) op->op_params;
+    const ggml_tensor * ids = op->src[0];
+
+    ggml_metal_kargs_spar args = {
+        /*.layer          =*/ p[GGML_SPAR_P_LAYER],
+        /*.k              =*/ (int32_t) ids->ne[0],
+        /*.n_tokens       =*/ (int32_t) ids->ne[1],
+        /*.nb_ids0        =*/ ids->nb[0],
+        /*.nb_ids1        =*/ ids->nb[1],
+        /*.off_seq        =*/ p[GGML_SPAR_P_OFF_SEQ],
+        /*.off_gate       =*/ p[GGML_SPAR_P_OFF_GATE],
+        /*.off_ntok       =*/ p[GGML_SPAR_P_OFF_NTOK],
+        /*.off_mirror     =*/ p[GGML_SPAR_P_OFF_MIRROR],
+        /*.mirror_stride  =*/ p[GGML_SPAR_P_MIRROR_STRIDE],
+        /*.off_remap      =*/ p[GGML_SPAR_P_OFF_REMAP],
+        /*.n_expert       =*/ p[GGML_SPAR_P_N_EXPERT],
+        /*.off_refresh    =*/ p[GGML_SPAR_P_OFF_REFRESH],
+        /*.refresh_stride =*/ p[GGML_SPAR_P_REFRESH_STRIDE],
+        /*.off_hb         =*/ p[GGML_SPAR_P_OFF_HB],
+        /*.off_abort      =*/ p[GGML_SPAR_P_OFF_ABORT],
+        /*.limit          =*/ p[GGML_SPAR_P_LIMIT],
+        /*.blob_words     =*/ p[GGML_SPAR_P_BLOB_WORDS],
+        /*.off_timeouts   =*/ p[GGML_SPAR_P_OFF_TIMEOUTS],
+        /*.pass           =*/ p[GGML_SPAR_P_MODE] >> 8,
+    };
+
+    const int32_t mode = p[GGML_SPAR_P_MODE] & 0xff;
+
+    auto pipeline = ggml_metal_library_get_pipeline_spar(lib, mode);
+
+    ggml_metal_encoder_set_pipeline(enc, pipeline);
+    ggml_metal_encoder_set_bytes   (enc, &args, sizeof(args), 0);
+    ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(ids),        1);
+    ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(op->src[1]), 2);
+
+    if (mode == 0 || mode == 2) {
+        ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(op), 3);
+        ggml_metal_encoder_dispatch_threadgroups(enc, 1, 1, 1, 1, 1, 1);
+    } else {
+        ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(op->src[2]), 3);
+        ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(op->src[3]), 4);
+        ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(op),         5);
+        ggml_metal_encoder_dispatch_threadgroups(enc, 64, 1, 1, 256, 1, 1);
+    }
+
+    return 1;
+}
