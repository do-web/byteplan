+    GGML_API struct ggml_tensor * ggml_spar_hint(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * ids,
+            struct ggml_tensor  * ctrl,
+            const int32_t       * params);
+
+    GGML_API struct ggml_tensor * ggml_spar_map(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * ids,
+            struct ggml_tensor  * ctrl,
+            struct ggml_tensor  * wait,
+            struct ggml_tensor  * pool,
+            const int32_t       * params);
