+
+// byteplan expert pool (GGML_OP_SPAR). The GPU and a CPU thread share `ctrl`; plain device loads may hit stale GPU
+// cache lines for CPU-written data, so everything shared is accessed system-coherently (MLX fence.metal pattern).
+// The spin is bounded: without a CPU heartbeat change for `limit` polls the kernel sets `abort` and returns.
+#pragma METAL internals : enable
+#ifndef __METAL_MEMORY_SCOPE_SYSTEM__
+#define __METAL_MEMORY_SCOPE_SYSTEM__ 3
+#endif
+constexpr constant metal::thread_scope spar_thread_scope_system = static_cast<metal::thread_scope>(__METAL_MEMORY_SCOPE_SYSTEM__);
+#define SPAR_FENCE() atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, spar_thread_scope_system)
+
+kernel void kernel_spar_wait(
+        constant ggml_metal_kargs_spar & args,
+        device const char * ids,
+        volatile coherent(system) device uint * ctrl,
+        device int * dst,
+        uint tid [[thread_position_in_grid]]) {
+    if (tid != 0) {
+        return;
+    }
+    // the ids are the same for every pass of a layer: the CPU plans all passes from pass 0
+    if (args.pass == 0) {
+        volatile coherent(system) device uint * mirror = ctrl + args.off_mirror + args.layer*args.mirror_stride;
+        for (int t = 0; t < args.n_tokens; ++t) {
+            for (int j = 0; j < args.k; ++j) {
+                mirror[t*args.k + j] = (uint) *((device const int *) (ids + j*args.nb_ids0 + t*args.nb_ids1));
+            }
+        }
+    }
+    ctrl[args.off_ntok + args.layer] = (uint) args.n_tokens | ((uint) args.pass << 16);
+    SPAR_FENCE();
+    const uint seq = ctrl[args.off_seq + args.layer] + 1;
+    ctrl[args.off_seq + args.layer] = seq;
+    SPAR_FENCE();
+
+    uint hb   = ctrl[args.off_hb];
+    uint idle = 0;
+    while (true) {
+        SPAR_FENCE();
+        if (ctrl[args.off_abort] != 0 || ctrl[args.off_gate + args.layer] >= seq) {
+            break;
+        }
+        const uint h = ctrl[args.off_hb];
+        if (h != hb) {
+            hb   = h;
+            idle = 0;
+        } else if (++idle > (uint) args.limit) {
+            ctrl[args.off_abort]     = 1;
+            ctrl[args.off_timeouts] += 1;
+            SPAR_FENCE();
+            break;
+        }
+    }
+    dst[0] = 0;
+}
+
+// prefetch hint: predicted ids [n, n_tokens] of a later layer into the hint area, then hint seq++ (no waiting)
+kernel void kernel_spar_hint(
+        constant ggml_metal_kargs_spar & args,
+        device const char * ids,
+        volatile coherent(system) device uint * ctrl,
+        device int * dst,
+        uint tid [[thread_position_in_grid]]) {
+    if (tid != 0) {
+        return;
+    }
+    volatile coherent(system) device uint * hint = ctrl + args.off_mirror + args.layer*args.mirror_stride;
+    for (int t = 0; t < args.n_tokens; ++t) {
+        for (int j = 0; j < args.k; ++j) {
+            hint[t*args.k + j] = (uint) *((device const int *) (ids + j*args.nb_ids0 + t*args.nb_ids1));
+        }
+    }
+    ctrl[args.off_ntok + args.layer] = (uint) args.n_tokens | ((uint) args.k << 16);
+    SPAR_FENCE();
+    ctrl[args.off_seq + args.layer] = ctrl[args.off_seq + args.layer] + 1;
+    SPAR_FENCE();
+    dst[0] = 0;
+}
+
+kernel void kernel_spar_map(
+        constant ggml_metal_kargs_spar & args,
+        device const char * ids,
+        volatile coherent(system) device uint * ctrl,
+        device const int * wait,
+        volatile coherent(system) device uint * pool,
+        device int * dst,
+        uint tid  [[thread_position_in_grid]],
+        uint ntid [[threads_per_grid]]) {
+    // re-read the slots the CPU just filled system-coherently and write them back through the GPU caches
+    volatile coherent(system) device uint * list = ctrl + args.off_refresh + args.layer*args.refresh_stride;
+    const uint n = list[0];
+    for (uint r = 0; r < n; ++r) {
+        volatile coherent(system) device uint * p = pool + (ulong) list[1 + r] * (ulong) args.blob_words;
+        for (uint i = tid; i < (uint) args.blob_words; i += ntid) {
+            p[i] = p[i];
+        }
+    }
+    SPAR_FENCE();
+
+    volatile coherent(system) device uint * remap = ctrl + args.off_remap + args.layer*args.n_expert;
+    for (uint i = tid; i < (uint) (args.k*args.n_tokens); i += ntid) {
+        const int t = i / args.k;
+        const int j = i % args.k;
+        const int e = *((device const int *) (ids + j*args.nb_ids0 + t*args.nb_ids1));
+        dst[i] = (int) remap[e];
+    }
+}
