new file mode 100644
index 0000000..a81e850
--- /dev/null
+++ b/src/llama-spar.h
@@ -0,0 +1,153 @@
+#pragma once
+
+// byteplan expert pool ("spar"): with a spar trunk (tools/compiler/spar_pack.py) the routed experts are not part
+// of the model buffers. They live in experts.bin; a per-layer pool of S slots holds the working set. For every MoE
+// layer the GPU publishes its expert ids and waits (GGML_OP_SPAR, bounded spin) until a CPU thread has loaded the
+// missing experts into slots; then the ids are mapped to slots and the unchanged MUL_MAT_ID kernels run on the pool.
+// Outputs stay bit-identical: same kernels, same data, only the address of an expert changes.
+
+#include "ggml.h"
+#include "llama.h"
+#include "ggml-backend.h"
+
+#include <atomic>
+#include <condition_variable>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <cstdint>
+#include <string>
+#include <thread>
+#include <vector>
+
+struct llama_spar {
+    // n_layer, n_expert, n_embd, n_ff: the model's shapes, experts.bin must match them
+    // load = false (memory-fit probe): pool and graph tensors only, no preload and no worker
+    llama_spar(const std::string & experts_path, int n_layer, int n_expert, int64_t n_embd, int64_t n_ff,
+               int n_expert_used, int n_slots, int n_ubatch, bool load,
+               llama_progress_callback progress = nullptr, void * progress_user_data = nullptr);
+    ~llama_spar();
+
+    llama_spar(const llama_spar &) = delete;
+    llama_spar & operator=(const llama_spar &) = delete;
+
+    bool has_layer(int il) const;
+
+    // GGML_OP_SPAR parameters of layer il
+    void params(int il, int32_t * p) const;
+
+    // the expert matrix `mat` (0 gate, 1 up, 2 down) of layer il as a [ne0, ne1, S] view into the pool
+    ggml_tensor * view(ggml_context * ctx, int il, int mat) const;
+
+    // the slot area of layer il (starts at the first aligned slot), for the refresh in GGML_OP_SPAR map
+    ggml_tensor * slots(ggml_context * ctx, int il) const;
+
+    // passes MoE layer il needs for n_tokens: the distinct experts of a ubatch go through its slots in groups
+    int n_pass(int il, int64_t n_tokens) const;
+
+    // aborts the process if the GPU gave up waiting: the pass is invalid and the recurrent state with it
+    void check() const;
+
+    // prefetch hint for layer il (decode-sized ubatches): the graph runs layer il's router on the previous layer's
+    // router input and publishes the top SPAR_HINT_N ids with ggml_spar_hint, the worker loads them in the background
+    static constexpr int SPAR_HINT_N = 16;
+    static constexpr int SPAR_HINT_T = 8;
+    bool hint_enabled(int il, int64_t n_tokens) const;
+    void hint_params(int il, int32_t * p) const;
+
+    ggml_tensor * ctrl = nullptr;
+    std::vector<ggml_tensor *> pool; // per layer, nullptr for layers without experts
+
+    int n_slots  = 0;              // requested average slots per layer
+    std::vector<int> layer_slots;  // slots of each layer (same total RAM, more where the profile shows more misses)
+    int n_expert = 0;
+
+private:
+    struct matrix {
+        ggml_type type;
+        int64_t   ne0, ne1;
+        uint64_t  slice_bytes, offset;
+    };
+
+    struct layer_state {
+        std::vector<int32_t>  slot_of;   // expert -> slot or -1
+        std::vector<int32_t>  expert_of; // slot -> expert or -1
+        std::vector<uint64_t> last_use;  // slot -> clock (== clock: pinned for the current pass)
+
+        // eviction by decayed use frequency (LFU with aging, ties by LRU): score halves every SPAR_HALF_LIFE tokens
+        std::vector<float>    score;     // expert -> score at score_tok
+        std::vector<uint64_t> score_tok; // expert -> token count of the layer at the last update
+        uint64_t tok = 0;                // tokens seen by this layer
+
+        // the current ubatch: its distinct experts and their groups, one group per pass
+        std::vector<int32_t>              distinct;
+        std::vector<std::vector<int32_t>> groups;
+        int pass = -1;
+
+        std::vector<char> prefetched; // slot -> filled by a prefetch since the last request (stats)
+        std::vector<char> loading;    // slot -> background read pending
+    };
+
+    void init(const std::string & experts_path, int n_layer_model, int n_expert_model, int64_t n_embd, int64_t n_ff,
+              int n_expert_used, int n_slots_req, int n_ubatch, bool load, llama_progress_callback progress, void * progress_user_data);
+    void load_header(const std::string & experts_path, int n_layer_model, int n_expert_model, int64_t n_embd, int64_t n_ff);
+    bool load_profile(const std::string & path, std::vector<std::vector<float>> & miss, std::vector<std::vector<int>> & rank) const;
+    void release();
+    static float score_now(const layer_state & st, int e);
+    void plan(int il, int n_tokens);
+    void serve(int il, uint32_t seq);
+    void prefetch(int il);
+    void io_loop();
+    void run();
+    char * slot_ptr(int il, int slot) const;
+    volatile uint32_t * c(int off) const;
+
+    int      fd = -1;
+    int      n_layer = 0, k = 0, t_max = 0;
+    matrix   mats[3] = {};
+    uint64_t blob_stride = 0, data_offset = 0;
+    std::vector<uint8_t> present;
+
+    // control block layout (uint32 units)
+    int off_abort = 0, off_timeouts = 1, off_hb = 2, off_seq = 64, off_gate = 128, off_ntok = 192;
+    int off_hint_seq = 256, off_hint_ntok = 320, off_remap = 384;
+    int off_refresh = 0, refresh_stride = 0, off_mirror = 0, mirror_stride = 0, off_hint = 0, hint_stride = 0, n_ctrl = 0;
+    int32_t limit = 0;
+
+    ggml_context *        ctx = nullptr;
+    ggml_backend_buffer_t buf = nullptr;
+    std::vector<size_t>   pad; // per layer, bytes from pool->data to the first 16 KiB aligned slot
+
+    std::vector<layer_state> state;
+    std::vector<uint32_t>    served, hint_served;
+
+    // background reads for prefetch hints; serve() waits for a layer's reads, their slots join its refresh list
+    struct io_job { int il, slot; int32_t expert; };
+    std::mutex                       io_mu;
+    std::condition_variable          io_cv;
+    std::deque<io_job>               io_q;
+    std::vector<std::thread>         io_threads;
+    std::unique_ptr<std::atomic<int>[]> inflight; // per layer
+    std::vector<std::vector<int>>    done_slots;  // per layer, guarded by io_mu
+    std::atomic<bool>                io_failed{false};
+    bool                             prefetch_on = false;
+public:
+    // predicted ranks considered, reads per hint, IO threads, layers ahead (env BYTEPLAN_SPAR_PF_*); measured best at S=358
+    int pf_ranks = 16, pf_max = 8, pf_io = 4, pf_ahead = 1;
+private:
+    uint64_t clock = 0;
+
+    std::thread       worker;
+    std::atomic<bool> stop{false};
+
+public:
+    // statistics (read after the run)
+    std::atomic<uint64_t> n_requests{0}, n_misses{0}, bytes_read{0};
+
+private:
