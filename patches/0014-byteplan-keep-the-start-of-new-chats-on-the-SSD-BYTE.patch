     server_metrics metrics;
 
@@ -1565,6 +1815,7 @@ private:
             SRV_TRC("%s", "prompt cache is disabled - use `--cache-ram N` to enable it\n");
         }
         SRV_TRC("%s", "for more info see https://github.com/ggml-org/llama.cpp/pull/16391\n");
+        prompt_disk.init(params_base, ctx_tgt);
 
         if (params_base.n_ctx_checkpoints > 0) {
             SRV_TRC("context checkpoints enabled, max = %d, min spacing = %d\n",
@@ -1858,6 +2109,17 @@ private:
 
                 SRV_TRC("prompt cache update took %.2f ms\n", (ggml_time_us() - t_start) / 1000.0);
             }
+
+            // byteplan: a longer stored start from the SSD; the slot's current state goes to the RAM tier first
+            if (prompt_disk.enabled() && task.type == SERVER_TASK_TYPE_COMPLETION) {
+                const int i = prompt_disk.find(task.tokens, ret->prompt.tokens.get_common_prefix(task.tokens));
+                if (i >= 0) {
+                    if (prompt_cache) {
+                        ret->prompt_save(*prompt_cache);
+                    }
+                    prompt_disk.load(i, ret->ctx_tgt, ret->ctx_dft, ret->id, ret->prompt, task.tokens.has_mtmd);
+                }
+            }
         }
 
         return ret;
@@ -2651,6 +2913,17 @@ private:
         // stash the draft's speculative state with the checkpoint
         common_speculative_get_state(spec.get(), slot.id, cur.data_spec);
 
+        // byteplan: the start of a new chat also goes to the SSD (text only, long enough to be worth it)
+        if (prompt_disk.enabled() && cur.n_tokens == keep && keep >= bp_prompt_disk::n_min) {
+            llama_tokens start(keep);
+            for (int64_t i = 0; i < keep; ++i) {
+                start[i] = slot.prompt.tokens[i]; // NULL at media positions
+            }
+            if (std::find(start.begin(), start.end(), LLAMA_TOKEN_NULL) == start.end()) {
+                prompt_disk.save(ctx_tgt, ctx_dft, slot.id, std::move(start));
+            }
+        }
+
         SLT_TRC(slot,
                 "created context checkpoint %d of %d (pos_min = %d, pos_max = %d, n_tokens = %" PRId64 ", size = %.3f MiB)\n",
                 (int) slot.prompt.checkpoints.size(), params_base.n_ctx_checkpoints, cur.pos_min,
