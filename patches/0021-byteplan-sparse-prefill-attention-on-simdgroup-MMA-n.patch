diff --git a/ggml/src/ggml-metal/kernels/fa_f16.metal b/ggml/src/ggml-metal/kernels/fa_f16.metal
index 2dfd379..ded9547 100644
--- a/ggml/src/ggml-metal/kernels/fa_f16.metal
+++ b/ggml/src/ggml-metal/kernels/fa_f16.metal
@@ -361,3 +361,197 @@ template [[host_name("kernel_flash_attn_ext_tensor_f16_dk512_dv512")]] kernel fl
 template [[host_name("kernel_flash_attn_ext_tensor_f16_dk576_dv512")]] kernel flash_attn_ext_tensor_t kernel_flash_attn_ext_tensor<576, 512, OP_FLASH_ATTN_EXT_TENSOR_NQPSG_LARGE>;
 
 #endif // GGML_METAL_HAS_TENSOR
+
+// byteplan: sparse prefill attention on simdgroup MMA. One threadgroup per (query, KV head) runs all heads of the KV
+// group (at most R) as the rows of one Q tile over the query's index list from kernel_flash_attn_ext_vec_idx, in
+// chunks of C rows. The heads of a query share its selection, so each K/V row is read once for all of them, straight
+// from the cache into the simdgroup matrices (thread_elements layout). f16 K/V; no ALiBi, softcap or sinks (the host
+// checks).
+template<short DK, short DV>
+kernel void kernel_flash_attn_ext_sparse(
+        constant ggml_metal_kargs_flash_attn_ext_vec & args,
+        device const char * q,
+        device const char * k,
+        device const char * v,
+        device const char * mask,
+        device const char * idx,
+        device       char * dst,
+        threadgroup  half * shmem_f16 [[threadgroup(0)]],
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort  tiitg[[thread_index_in_threadgroup]],
+        ushort  tiisg[[thread_index_in_simdgroup]],
+        ushort  sgitg[[simdgroup_index_in_threadgroup]]) {
+    constexpr short R   = 16;
+    constexpr short C   = 32;
+    constexpr short NSG = 4;
+    constexpr short NT  = NSG*N_SIMDWIDTH;
+    constexpr short NJ  = DV/8/NSG;
+    constexpr short RS  = R/NSG;
+
+    static_assert(C == N_SIMDWIDTH && C/8 == NSG, "chunk");
+    static_assert(DK % 8 == 0 && DV % (8*NSG) == 0, "head sizes");
+
+    const int iq1  = tgpig[0];
+    const int ikv2 = tgpig[1];
+    const int iq3  = tgpig[2];
+
+    const int G  = args.ne02/args.ne_12_2;
+    const int h0 = ikv2*G;
+
+    threadgroup half  * sq  = shmem_f16;                         // R x DK
+    threadgroup float * ss  = (threadgroup float *) (sq + R*DK); // 2 x R x C (double buffered)
+    threadgroup float * sms = ss + 2*R*C;                        // R
+    threadgroup half  * smk = (threadgroup half *) (sms + R);    // C
+
+    k += ikv2*args.nb12 + (iq3/(args.ne03/args.ne_12_3))*args.nb13;
+    v += ikv2*args.nb22 + (iq3/(args.ne03/args.ne_12_3))*args.nb23;
+
+    device const half * pm   = (device const half *) (mask + iq1*args.nb31 + (iq3%args.ne33)*args.nb33);
+    device const int  * pidx = (device const int *) idx + ((int64_t) (iq3%args.ne33)*args.ne31 + iq1%args.ne31)*args.n_kv_max_padded;
+
+    for (int i = tiitg; i < R*DK/4; i += NT) {
+        const int r = i/(DK/4);
+        ((threadgroup half4 *) sq)[i] = r < G
+            ? (half4) ((device const float4 *) (q + iq1*args.nb01 + (h0 + r)*args.nb02 + iq3*args.nb03))[i%(DK/4)]
+            : half4(0.0h);
+    }
+
+    simdgroup_float8x8 lo[2][NJ];
+    FOR_UNROLL (short rf = 0; rf < 2; ++rf) {
+        FOR_UNROLL (short j = 0; j < NJ; ++j) {
+            lo[rf][j] = make_filled_simdgroup_matrix<float, 8>(0.0f);
+        }
+    }
+
+    float M[RS];
+    float S[RS];
+    FOR_UNROLL (short j = 0; j < RS; ++j) {
+        M[j] = -FLT_MAX/2;
+        S[j] = 0.0f;
+    }
+
+    // this thread's two elements of an 8x8 simdgroup matrix: row fm, columns fn and fn + 1
+    const short fm = (tiisg/4 & 4) + (tiisg/2)%4;
+    const short fn = (tiisg/4 & 2)*2 + (tiisg%2)*2;
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    for (int ic = 0, b = 0; ic < args.n_kv_max_padded; ic += C, b ^= 1) {
+        if (pidx[ic] < 0) {
+            break;
+        }
+
+        threadgroup float * sb = ss + b*R*C;
+
+        if (tiitg < C) {
+            const int i11 = pidx[ic + tiitg];
+            smk[tiitg] = i11 >= 0 ? pm[i11] : -INFINITY;
+        }
+
+        // S^T = K*Q^T: simdgroup s takes keys 8s..8s+7; its lanes read their key row straight from the cache
+        {
+            const int  i11 = pidx[ic + 8*sgitg + fm];
+            device const half2 * pk = (device const half2 *) (k + max(i11, 0)*args.nb11) + fn/2;
+
+            simdgroup_float8x8 mqk[2] = { make_filled_simdgroup_matrix<float, 8>(0.0f), make_filled_simdgroup_matrix<float, 8>(0.0f) };
+
+            FOR_UNROLL (short i = 0; i < DK/8; ++i) {
+                simdgroup_half8x8 mk;
+                simdgroup_half8x8 mq0;
+                simdgroup_half8x8 mq1;
+
+                const half2 kv2 = i11 >= 0 ? pk[4*i] : half2(0.0h);
+                mk.thread_elements()[0] = kv2[0];
+                mk.thread_elements()[1] = kv2[1];
+
+                simdgroup_load(mq0, sq + 8*i,        DK, 0, true);
+                simdgroup_load(mq1, sq + 8*DK + 8*i, DK, 0, true);
+
+                simdgroup_multiply_accumulate(mqk[0], mk, mq0, mqk[0]);
+                simdgroup_multiply_accumulate(mqk[1], mk, mq1, mqk[1]);
+            }
+
+            simdgroup_store(mqk[0], sb +       8*sgitg, C, 0, true);
+            simdgroup_store(mqk[1], sb + 8*C + 8*sgitg, C, 0, true);
+        }
+
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+
+        FOR_UNROLL (short j = 0; j < RS; ++j) {
+            const short r = sgitg + NSG*j;
+
+            const float s = fma(sb[r*C + tiisg], args.scale, (float) smk[tiisg]);
+            const float m = M[j];
+
+            M[j] = simd_max(max(m, s));
+
+            const float ms = exp(m - M[j]);
+            const float vs = exp(s - M[j]);
+
+            S[j] = S[j]*ms + simd_sum(vs);
+
+            sb[r*C + tiisg] = vs;
+            if (tiisg == 0) {
+                sms[r] = ms;
+            }
+        }
+
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+
+        // O = diag(ms)*O + P*V: simdgroup s owns output columns [8*NJ*s, 8*NJ*(s + 1))
+        FOR_UNROLL (short rf = 0; rf < 2; ++rf) {
+            const float ms = sms[8*rf + fm];
+
+            FOR_UNROLL (short j = 0; j < NJ; ++j) {
+                thread auto & te = lo[rf][j].thread_elements();
+                te[0] *= ms;
+                te[1] *= ms;
+            }
+        }
+
+        FOR_UNROLL (short kc = 0; kc < C/8; ++kc) {
+            simdgroup_float8x8 mp0;
+            simdgroup_float8x8 mp1;
+            simdgroup_load(mp0, sb +       8*kc, C, 0, false);
+            simdgroup_load(mp1, sb + 8*C + 8*kc, C, 0, false);
+
+            const int i11 = pidx[ic + 8*kc + fm];
+            device const half2 * pv = (device const half2 *) (v + max(i11, 0)*args.nb21) + (8*NJ*sgitg + fn)/2;
+
+            FOR_UNROLL (short j = 0; j < NJ; ++j) {
+                simdgroup_half8x8 mv;
+                const half2 vv2 = i11 >= 0 ? pv[4*j] : half2(0.0h);
+                mv.thread_elements()[0] = vv2[0];
+                mv.thread_elements()[1] = vv2[1];
+
+                simdgroup_multiply_accumulate(lo[0][j], mp0, mv, lo[0][j]);
+                simdgroup_multiply_accumulate(lo[1][j], mp1, mv, lo[1][j]);
+            }
+        }
+    }
+
+    FOR_UNROLL (short j = 0; j < RS; ++j) {
+        if (tiisg == 0) {
+            sms[sgitg + NSG*j] = S[j] == 0.0f ? 0.0f : 1.0f/S[j];
+        }
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
