+/**
+ * Pure helpers for conversation compaction (byteplan): the summary lives in the system message of the
+ * compacted conversation, wrapped in COMPACT.SUMMARY_OPEN/CLOSE so a second compaction replaces it.
+ */
+
+import { COMPACT } from '$lib/constants';
+import { MessageRole } from '$lib/enums';
+import type { ApiChatMessageData, DatabaseMessage } from '$lib/types';
+
+/** Splits a system prompt into the user's own prompt and an embedded conversation summary. */
+export function splitSummary(system: string): { prompt: string; summary: string | null } {
+	const start = system.indexOf(COMPACT.SUMMARY_OPEN);
+	const end = start < 0 ? -1 : system.indexOf(COMPACT.SUMMARY_CLOSE, start);
+
+	if (end < 0) return { prompt: system.trim(), summary: null };
+
+	return {
+		prompt: (system.slice(0, start) + system.slice(end + COMPACT.SUMMARY_CLOSE.length)).trim(),
+		summary: system.slice(start + COMPACT.SUMMARY_OPEN.length, end).trim()
+	};
+}
+
+/** System prompt of a compacted conversation: the user's prompt plus the new summary (an old one is replaced). */
+export function joinSummary(system: string, summary: string): string {
+	const { prompt } = splitSummary(system);
+	const block = `${COMPACT.SUMMARY_OPEN}\n${summary.trim()}\n${COMPACT.SUMMARY_CLOSE}`;
+
+	return prompt ? `${prompt}\n\n${block}` : block;
+}
+
+export function compactedTitle(name: string): string {
+	return name.endsWith(COMPACT.TITLE_SUFFIX) ? name : name + COMPACT.TITLE_SUFFIX;
+}
+
+/** History size as the server counted it for the last reply (prompt + cache + output), null without timings. */
+export function historyTokens(messages: DatabaseMessage[]): number | null {
+	const timings = [...messages]
+		.reverse()
+		.find((m) => m.role === MessageRole.ASSISTANT && m.timings)?.timings;
+
+	return timings
+		? (timings.prompt_n ?? 0) + (timings.cache_n ?? 0) + (timings.predicted_n ?? 0)
+		: null;
+}
+
+/** Assistant rows left empty by a failed or aborted reply carry nothing worth summarizing. */
+export function isEmptyAssistant(m: DatabaseMessage): boolean {
+	return (
+		m.role === MessageRole.ASSISTANT && !m.content.trim() && !m.toolCalls && !m.reasoningContent
+	);
+}
+
+export function messageChars(m: ApiChatMessageData): number {
+	const content =
+		typeof m.content === 'string' ? m.content.length : JSON.stringify(m.content).length;
+
+	return (
+		content +
+		(m.reasoning_content?.length ?? 0) +
+		(m.tool_calls ? JSON.stringify(m.tool_calls).length : 0)
+	);
+}
+
+const totalChars = (messages: ApiChatMessageData[]) =>
+	messages.reduce((n, m) => n + messageChars(m), 0);
+
+function headTail(text: string): string {
+	const keep = COMPACT.TOOL_OUTPUT_KEEP_CHARS / 2;
+
+	return `${text.slice(0, keep)}\n[... ${text.length - 2 * keep} characters omitted ...]\n${text.slice(-keep)}`;
+}
+
+/**
+ * Shrinks the history to maxChars for the summary request: first long tool outputs keep only head and tail,
+ * then whole turns (user message up to the next one, so tool calls keep their results) are dropped from the
+ * middle. The system message, the first turn and the last COMPACT.KEEP_LAST_TURNS turns always stay; the
+ * result can still be too large, the caller checks.
+ */
+export function trimForBudget(
+	messages: ApiChatMessageData[],
+	maxChars: number
+): { messages: ApiChatMessageData[]; omitted: boolean } {
+	if (totalChars(messages) <= maxChars) return { messages, omitted: false };
+
+	const cut = messages.map((m) =>
+		m.role === MessageRole.TOOL &&
+		typeof m.content === 'string' &&
+		m.content.length > COMPACT.TOOL_OUTPUT_KEEP_CHARS
+			? { ...m, content: headTail(m.content) }
+			: m
+	);
+
+	if (totalChars(cut) <= maxChars) return { messages: cut, omitted: false };
+
+	const turnStarts = cut.flatMap((m, i) => (m.role === MessageRole.USER ? [i] : []));
+	const head = cut.slice(0, turnStarts[1] ?? cut.length);
+	// dropping k + 1 middle turns keeps head plus everything from turn k + 2 on
+	const candidates = turnStarts
+		.slice(1, -COMPACT.KEEP_LAST_TURNS)
+		.map((_, k) => [...head, ...cut.slice(turnStarts[k + 2])]);
+	const fitting = candidates.find((c) => totalChars(c) <= maxChars) ?? candidates.at(-1);
+
+	return fitting ? { messages: fitting, omitted: true } : { messages: cut, omitted: false };
+}
