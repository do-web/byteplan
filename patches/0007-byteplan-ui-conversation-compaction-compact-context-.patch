diff --git a/tools/ui/src/lib/stores/chat/compact.svelte.ts b/tools/ui/src/lib/stores/chat/compact.svelte.ts
new file mode 100644
index 0000000..7ca21a6
--- /dev/null
+++ b/tools/ui/src/lib/stores/chat/compact.svelte.ts
@@ -0,0 +1,170 @@
+/**
+ * compactStore - conversation compaction (byteplan)
+ *
+ * Summarizes the active conversation with the model (thinking off) and continues in a new
+ * conversation whose system message carries the summary; the original stays untouched.
+ * Entry points: the /compact command, the context gauge and auto-compaction before sending.
+ */
+
+import { COMPACT } from '$lib/constants';
+import { MessageRole, MessageType } from '$lib/enums';
+import { ChatService } from '$lib/services/chat.service';
+// direct imports between stores, not via the barrel, to avoid circular deps
+import { agenticStore } from '$lib/stores/agentic/index.svelte';
+import { chatStore } from '$lib/stores/chat/index.svelte';
+import { conversationsStore } from '$lib/stores/conversations/index.svelte';
+import { modelsStore } from '$lib/stores/models/index.svelte';
+import { toolsStore } from '$lib/stores/tools.svelte';
+import type { ApiChatMessageData, ChatMessageTimings } from '$lib/types';
+import {
+	historyTokens,
+	isEmptyAssistant,
+	joinSummary,
+	messageChars,
+	trimForBudget
+} from '$lib/utils';
+import { toast } from 'svelte-sonner';
+
+class CompactStore {
+	isCompacting = $state(false);
+	private abortController: AbortController | null = null;
+
+	cancel(): void {
+		this.abortController?.abort();
+	}
+
+	/**
+	 * Compacts the active conversation into a new one and makes it active.
+	 * @param hint - Optional extra focus for the summary (`/compact <hint>`)
+	 * @returns true when the new conversation is active, false when nothing changed
+	 */
+	async compact(hint = ''): Promise<boolean> {
+		const source = conversationsStore.activeConversation;
+
+		if (!source || this.isCompacting) return false;
+
+		if (chatStore.isChatLoadingInternal(source.id) || agenticStore.isRunning(source.id)) {
+			toast.info('Wait until the current reply has finished');
+
+			return false;
+		}
+
+		const path = conversationsStore.activeMessages.filter(
+			(m) => m.type !== MessageType.ROOT && !isEmptyAssistant(m)
+		);
+
+		if (!path.some((m) => m.role === MessageRole.ASSISTANT)) {
+			toast.info('Nothing to compact yet');
+
+			return false;
+		}
+
+		this.isCompacting = true;
+		this.abortController = new AbortController();
+
+		const toastId = toast.loading('Compacting conversation...', {
+			action: { label: 'Cancel', onClick: () => this.cancel() },
+			duration: Number.POSITIVE_INFINITY
+		});
+
+		try {
+			const history = await ChatService.normalizeMessagesForApi(path);
+			const summary = await this.summarize(this.fitToContext(history, historyTokens(path)), hint);
+
+			if (summary === null) return false;
+
+			const system = path.find((m) => m.role === MessageRole.SYSTEM)?.content ?? '';
+			const conversation = await conversationsStore.createCompactedConversation(source);
+
+			await chatStore.seedConversation(conversation, joinSummary(system, summary));
+			toast.success('Conversation compacted, the original is kept in the sidebar');
+
+			return true;
+		} catch (error) {
+			const message = error instanceof Error ? error.message : String(error);
+
+			toast.error(`Compaction failed: ${message}`);
+
+			return false;
+		} finally {
+			toast.dismiss(toastId);
+			this.isCompacting = false;
+			this.abortController = null;
+		}
+	}
+
+	/** Shrinks the history so history + instruction + summary fit into the context window. */
+	private fitToContext(
+		history: ApiChatMessageData[],
+		tokens: number | null
+	): { messages: ApiChatMessageData[]; omitted: boolean } {
+		const modelId = modelsStore.activeModelId;
+		const nCtx = modelId ? modelsStore.props.getModelContextSize(modelId) : null;
+
+		if (!nCtx) return { messages: history, omitted: false };
+
+		const chars = history.reduce((n, m) => n + messageChars(m), 0);
+		const historyTokenCount = tokens ?? chars / COMPACT.CHARS_PER_TOKEN;
+		const budget = nCtx - COMPACT.MAX_TOKENS - COMPACT.RESERVE_TOKENS;
+
+		return trimForBudget(history, (chars * budget) / Math.max(historyTokenCount, 1));
+	}
+
+	/** @returns the summary, or null when it was cancelled (errors throw) */
+	private async summarize(
+		{ messages, omitted }: { messages: ApiChatMessageData[]; omitted: boolean },
+		hint: string
+	): Promise<string | null> {
+		const instruction =
+			COMPACT.PROMPT +
+			(omitted ? COMPACT.OMITTED_NOTE : '') +
+			(hint.trim() ? COMPACT.HINT_PREFIX + hint.trim() : '');
+		// same tools as the chat, so the prompt prefix matches and comes from the server cache
+		const policy = conversationsStore.preferences;
+		const tools = toolsStore.getEnabledToolsForLLM(
+			new Set(policy.getDisabledTools()),
+			new Set(policy.getDisabledToolCategories())
+		);
+		const signal = this.abortController?.signal;
+
+		let summary = '';
+		let timings: ChatMessageTimings | undefined;
+
+		await ChatService.sendMessage(
+			[...messages, { content: instruction, role: MessageRole.USER }],
+			{
+				...chatStore.getApiOptions(),
+				custom: tools.length > 0 ? { tool_choice: 'none' } : undefined,
+				enableThinking: false,
+				max_tokens: COMPACT.MAX_TOKENS,
+				onChunk: (chunk: string) => {
+					summary += chunk;
+				},
+				onTimings: (t?: ChatMessageTimings) => {
+					if (t) timings = t;
+				},
+				stream: true,
+				tools: tools.length > 0 ? tools : undefined
+			},
+			undefined,
+			signal
+		);
+
+		// sendMessage swallows an abort and resolves, so check the signal
+		if (signal?.aborted) {
+			toast.info('Compaction cancelled');
+
+			return null;
+		}
+
+		if ((timings?.predicted_n ?? 0) >= COMPACT.MAX_TOKENS) {
+			throw new Error('the summary hit the length limit');
+		}
+
+		if (!summary.trim()) throw new Error('the model returned an empty summary');
+
+		return summary;
+	}
+}
+
+export const compactStore = new CompactStore();
