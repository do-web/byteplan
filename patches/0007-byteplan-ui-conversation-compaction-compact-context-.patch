+// Conversation compaction helpers (byteplan): summary embedding must not stack on repeated
+// compaction, and trimming must keep the task (first turn), the latest turns and tool pairs.
+
+import { COMPACT } from '$lib/constants';
+import { MessageRole, MessageType } from '$lib/enums';
+import type { ApiChatMessageData, DatabaseMessage } from '$lib/types';
+import {
+	compactedTitle,
+	historyTokens,
+	isEmptyAssistant,
+	joinSummary,
+	splitSummary,
+	trimForBudget
+} from '$lib/utils/compact';
+import { describe, expect, it } from 'vitest';
+
+const msg = (role: MessageRole, content: string, extra: Partial<ApiChatMessageData> = {}) =>
+	({ content, role, ...extra }) as ApiChatMessageData;
+const db = (role: MessageRole, content: string, extra: Partial<DatabaseMessage> = {}) =>
+	({
+		children: [],
+		content,
+		convId: 'c1',
+		id: Math.random().toString(),
+		parent: null,
+		role,
+		timestamp: 0,
+		type: MessageType.TEXT,
+		...extra
+	}) as DatabaseMessage;
+
+/** system + n turns of user/assistant, each message `size` characters long */
+function chat(turns: number, size: number): ApiChatMessageData[] {
+	return [
+		msg(MessageRole.SYSTEM, 'sys'),
+		...Array.from({ length: turns }, (_, i) => [
+			msg(MessageRole.USER, `u${i}`.padEnd(size, '.')),
+			msg(MessageRole.ASSISTANT, `a${i}`.padEnd(size, '.'))
+		]).flat()
+	];
+}
+
+describe('summary embedding', () => {
+	it('replaces an earlier summary instead of stacking it', () => {
+		const once = joinSummary('Be brief.', 'first');
+		const twice = joinSummary(once, 'second');
+
+		expect(splitSummary(twice)).toEqual({ prompt: 'Be brief.', summary: 'second' });
+		expect(twice.split(COMPACT.SUMMARY_OPEN)).toHaveLength(2);
+	});
+
+	it('works without a user system prompt', () => {
+		expect(splitSummary(joinSummary('', 'only'))).toEqual({ prompt: '', summary: 'only' });
+		expect(splitSummary('plain prompt')).toEqual({ prompt: 'plain prompt', summary: null });
+	});
+
+	it('adds the title suffix once', () => {
+		expect(compactedTitle(compactedTitle('Chat'))).toBe(`Chat${COMPACT.TITLE_SUFFIX}`);
+	});
+});
+
+describe('history size and placeholders', () => {
+	it('reads the last assistant timings as prompt + cache + output', () => {
+		const messages = [
+			db(MessageRole.ASSISTANT, 'old', { timings: { cache_n: 1, predicted_n: 1, prompt_n: 1 } }),
+			db(MessageRole.USER, 'q'),
+			db(MessageRole.ASSISTANT, 'new', { timings: { cache_n: 900, predicted_n: 50, prompt_n: 50 } })
+		];
+
+		expect(historyTokens(messages)).toBe(1000);
+		expect(historyTokens([db(MessageRole.USER, 'q')])).toBeNull();
+	});
+
+	it('flags only empty assistant rows', () => {
+		expect(isEmptyAssistant(db(MessageRole.ASSISTANT, '  '))).toBe(true);
+		expect(isEmptyAssistant(db(MessageRole.ASSISTANT, '', { toolCalls: '[{}]' }))).toBe(false);
+		expect(isEmptyAssistant(db(MessageRole.USER, ''))).toBe(false);
+	});
+});
+
+describe('trimForBudget', () => {
+	it('leaves a history that fits untouched', () => {
+		const messages = chat(3, 10);
+
+		expect(trimForBudget(messages, 10_000)).toEqual({ messages, omitted: false });
+	});
+
+	it('shortens long tool outputs before dropping turns', () => {
+		const long = 'x'.repeat(COMPACT.TOOL_OUTPUT_KEEP_CHARS * 5);
+		const messages = [
+			...chat(1, 10),
+			msg(MessageRole.ASSISTANT, '', { tool_calls: [{ id: 't1' } as never] }),
+			msg(MessageRole.TOOL, long, { tool_call_id: 't1' })
+		];
+		const { messages: out, omitted } = trimForBudget(messages, COMPACT.TOOL_OUTPUT_KEEP_CHARS * 2);
+
+		expect(omitted).toBe(false);
+		expect(out).toHaveLength(messages.length);
+		expect((out.at(-1)?.content as string).length).toBeLessThan(long.length);
+	});
+
+	it('drops middle turns but keeps system, the first turn and the last turns', () => {
+		const messages = chat(8, 100);
+		const { messages: out, omitted } = trimForBudget(messages, 900);
+		const users = out
+			.filter((m) => m.role === MessageRole.USER)
+			.map((m) => (m.content as string).slice(0, 2));
+
+		expect(omitted).toBe(true);
+		expect(out[0].role).toBe(MessageRole.SYSTEM);
+		expect(users[0]).toBe('u0');
+		expect(users.slice(-COMPACT.KEEP_LAST_TURNS)).toEqual(['u6', 'u7']);
+		expect(out.reduce((n, m) => n + (m.content as string).length, 0)).toBeLessThanOrEqual(900);
+	});
+
+	it('never splits a tool call from its result', () => {
+		const turn = (i: number) => [
+			msg(MessageRole.USER, `u${i}`.padEnd(100, '.')),
+			msg(MessageRole.ASSISTANT, '', { tool_calls: [{ id: `t${i}` } as never] }),
+			msg(MessageRole.TOOL, 'r'.padEnd(100, '.'), { tool_call_id: `t${i}` }),
+			msg(MessageRole.ASSISTANT, `a${i}`.padEnd(100, '.'))
+		];
+		const messages = [msg(MessageRole.SYSTEM, 'sys'), ...[0, 1, 2, 3, 4, 5].flatMap(turn)];
+		const { messages: out } = trimForBudget(messages, 1500);
+
+		out.forEach((m, i) => {
+			if (m.role === MessageRole.TOOL)
+				expect(out[i - 1].tool_calls?.[0]).toEqual({ id: m.tool_call_id });
+		});
+	});
+});
