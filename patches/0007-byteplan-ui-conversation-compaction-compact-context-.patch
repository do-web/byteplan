+	/**
+	 * Writes the opening rows of a fresh conversation: root, the system prompt (if any) and, when a
+	 * working directory is set, the synthetic cwd message so the model sees it on its first turn.
+	 * @returns The id of the last row, the parent for the first user message
+	 */
+	async seedConversation(conv: DatabaseConversation, systemPrompt: string): Promise<string> {
+		let lastId = await DatabaseService.createRootMessage(conv.id);
+
+		if (systemPrompt) {
+			const systemMessage = await DatabaseService.createSystemMessage(
+				conv.id,
+				systemPrompt,
+				lastId
+			);
+
+			conversationsStore.addMessageToActive(systemMessage);
+			lastId = systemMessage.id;
+		}
+
+		if (conv.cwd) {
+			const cwdMessage = await this.addMessage(
+				MessageRole.USER,
+				formatCwdMessage(conv.cwd, await toolsStore.resolveServerHome()),
+				MessageType.TEXT,
+				lastId,
+				undefined,
+				true
+			);
+
+			lastId = cwdMessage.id;
+		}
+
