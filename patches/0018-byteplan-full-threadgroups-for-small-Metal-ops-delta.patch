+// byteplan: decode and verify (few tokens): one thread per row instead of one threadgroup of 1-2 threads per row;
+// the same sum per output as kernel_ssm_conv_f32_f32(_4), so the results are bit-identical
+template<bool V4>
+kernel void kernel_ssm_conv_f32_f32_rows(
+        constant ggml_metal_kargs_ssm_conv & args,
+        device const  void * src0,
+        device const  void * src1,
+        device       float * dst,
+        uint3 tgpig[[threadgroup_position_in_grid]],
+        uint3 tpitg[[thread_position_in_threadgroup]],
+        uint3   ntg[[threads_per_threadgroup]]) {
+    const int64_t ir = (int64_t) tgpig.x*ntg.x + tpitg.x;
+    const int64_t i2 = tgpig.y;
+    const int64_t i3 = tgpig.z;
+
+    if (ir >= args.ne01) {
+        return;
+    }
+
+    const int64_t nc = FC_ssm_conv_nc;
+
+    device const char * s = (device const char *) src0 + ir*args.nb01 + i2*args.nb00 + i3*args.nb02;
+    device const char * c = (device const char *) src1 + ir*args.nb11;
+    device       float * x = (device float *) ((device char *) dst + ir*args.nb0 + i2*args.nb1 + i3*args.nb2);
+
+    float sumf = 0.0f;
+
+    if (V4) {
+        FOR_UNROLL (int64_t i0 = 0; i0 < nc/4; ++i0) {
+            sumf += dot(((device const float4 *) s)[i0], ((device const float4 *) c)[i0]);
+        }
+    } else {
+        FOR_UNROLL (int64_t i0 = 0; i0 < nc; ++i0) {
+            sumf += ((device const float *) s)[i0] * ((device const float *) c)[i0];
+        }
+    }
+
+    x[0] = FC_ssm_conv_silu ? sumf/(1.0f + exp(-sumf)) : sumf;
+}
+
+template [[host_name("kernel_ssm_conv_f32_f32_rows")]]   kernel decltype(kernel_ssm_conv_f32_f32_rows<false>) kernel_ssm_conv_f32_f32_rows<false>;
+template [[host_name("kernel_ssm_conv_f32_f32_rows_4")]] kernel decltype(kernel_ssm_conv_f32_f32_rows<true>)  kernel_ssm_conv_f32_f32_rows<true>;
+
 constant short FC_ssm_conv_bs   [[function_constant(FC_SSM_CONV + 0)]];
 
