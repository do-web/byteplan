+++ b/ggml/src/ggml-metal/ggml-metal-device.cpp
@@ -731,7 +731,10 @@ ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_gated_delta_net(
     GGML_ASSERT(op->ne[0] == ne20 * ne21);
     GGML_ASSERT(ne20 % 32 == 0);
 
-    snprintf(base, 256, "kernel_gated_delta_net_%s_%d", ggml_type_name(op->src[0]->type), nsg);
+    // byteplan: 4 columns per simdgroup for 128-wide heads (see kernel_gated_delta_net_impl, CPS)
+    const int cps = nsg == 4 ? 4 : 1;
+
+    snprintf(base, 256, "kernel_gated_delta_net_%s_%d%s", ggml_type_name(op->src[0]->type), nsg, cps == 4 ? "_c4" : "");
     // byteplan: ids (src[6]) pick each sequence's row of the whole state cache
     const bool ids = op->src[6] != nullptr;
     snprintf(name, 256, "%s_ne20=%d_ne30=%d_K=%d_ids=%d", base, ne20, ne30, K, ids ? 1 : 0);
@@ -751,6 +754,7 @@ ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_gated_delta_net(
     }
 
     res.nsg = nsg;
+    res.nr0 = cps;
 
     return res;
 }
