 ggml/src/ggml-metal/ggml-metal-device.h   |   1 +
 ggml/src/ggml-metal/ggml-metal-impl.h     |   3 +
 ggml/src/ggml-metal/ggml-metal-ops.cpp    |   5 +-
 ggml/src/ggml-metal/kernels/mul_mm.metal  | 155 ++++++++++++++++++++++
 tests/test-backend-ops.cpp                |   5 +
 6 files changed, 207 insertions(+), 1 deletion(-)

