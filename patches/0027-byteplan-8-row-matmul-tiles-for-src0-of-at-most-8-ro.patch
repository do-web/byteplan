 // byteplan: tokens per threadgroup of the mul_mm_id expert map
 #define N_MM_ID_MAP_CHUNK 32
 
+// byteplan: simdgroups (8 src1 rows each) per threadgroup of kernel_mul_mm_n8
+#define N_MM_N8_NSG 1
