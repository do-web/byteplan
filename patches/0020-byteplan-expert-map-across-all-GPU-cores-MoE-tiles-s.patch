 #endif // GGML_METAL_HAS_TENSOR
 
+// byteplan: the expert map runs as one threadgroup per chunk of N_MM_ID_MAP_CHUNK tokens instead of a single
+// threadgroup scanning all tokens on one GPU core: map0_cnt counts the rows of each expert per chunk, map0 writes
+// them after the rows of the earlier chunks - the same lists in the same order
+template<short ne20> // n_expert_used
+kernel void kernel_mul_mm_id_map0_cnt(
+        constant ggml_metal_kargs_mul_mm_id_map0 & args,
+        device  const char * src2,
+        device        char * hcnt,
+        threadgroup   char * shmem [[threadgroup(0)]],
+        uint   tgpig[[threadgroup_position_in_grid]],
+        ushort tpitg[[thread_position_in_threadgroup]],
+        ushort   ntg[[threads_per_threadgroup]]) {
+    threadgroup atomic_uint * hist = (threadgroup atomic_uint *) shmem;
+
+    atomic_store_explicit(&hist[tpitg], 0u, memory_order_relaxed);
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    const int t0 = tgpig*N_MM_ID_MAP_CHUNK;
+    const int nt = min(N_MM_ID_MAP_CHUNK, args.ne21 - t0);
+
+    for (int j = tpitg; j < nt*ne20; j += ntg) {
+        // same truncation as the uint16_t ids in map0
+        const uint16_t e = (uint16_t) ((device const int32_t *) (src2 + (t0 + j/ne20)*args.nb21))[j%ne20];
+        if (e < args.ne02) {
+            atomic_fetch_add_explicit(&hist[e], 1u, memory_order_relaxed);
+        }
+    }
+
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    ((device uint32_t *) hcnt)[tgpig*args.ne02 + tpitg] = atomic_load_explicit(&hist[tpitg], memory_order_relaxed);
+}
